@page "/dashboard/admin/tickets"
@layout Shared.Layout.DashboardLayout
@inject Services.IStoreApi Api
@inject Services.ToastService Toast

<PageTitle>تیکت‌های پشتیبانی — مدیریت</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">تیکت‌های پشتیبانی</h1>
        <p class="page-sub">پاسخ‌گویی و تغییرِ وضعیتِ درخواست‌ها.</p>
    </div>
</div>

<div class="toolbar">
    <div class="search" style="max-width:340px">
        <span class="search__icon"><Icon Name="search" Size="16" /></span>
        <input class="input" @bind="search" @bind:event="oninput" @onkeyup="OnSearch" placeholder="جستجو در شماره، موضوع یا مشتری…" aria-label="جستجو" />
    </div>
    <div class="seg seg--sm">
        <button class="seg__btn @(status is null ? "is-active" : "")" @onclick="() => Pick(null)">همه</button>
        <button class="seg__btn @(status == TicketStatus.Open ? "is-active" : "")" @onclick="() => Pick(TicketStatus.Open)">باز</button>
        <button class="seg__btn @(status == TicketStatus.InProgress ? "is-active" : "")" @onclick="() => Pick(TicketStatus.InProgress)">در حال بررسی</button>
        <button class="seg__btn @(status == TicketStatus.WaitingCustomer ? "is-active" : "")" @onclick="() => Pick(TicketStatus.WaitingCustomer)">منتظر مشتری</button>
        <button class="seg__btn @(status == TicketStatus.Resolved ? "is-active" : "")" @onclick="() => Pick(TicketStatus.Resolved)">حل‌شده</button>
    </div>
</div>

<div class="card table-wrap">
    @if (paged is null)
    {
        <div style="padding:var(--sp-4)">@for (var i = 0; i < 5; i++) { <Skeleton Kind="row" /> }</div>
    }
    else if (paged.Items.Count == 0)
    {
        <EmptyState Icon="ticket" Title="تیکتی یافت نشد" Text="با این فیلترها موردی ثبت نشده است." />
    }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr><th>شماره</th><th>موضوع</th><th>مشتری</th><th>اولویت</th><th>وضعیت</th><th>پیام‌ها</th><th>آخرین تغییر</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in paged.Items)
                    {
                        <tr>
                            <td><code class="order-code">@t.Reference</code></td>
                            <td>
                                <a href="/dashboard/tickets/@t.Id" style="font-weight:600;color:inherit;text-decoration:none">@t.Subject</a>
                                <div class="tiny muted" style="margin-top:3px">@t.Category @(t.ProductName is not null ? " • " + t.ProductName : "")</div>
                            </td>
                            <td class="small">@(t.UserName ?? "—")</td>
                            <td><StatusBadge Status="@t.Priority.ToString()" Kind="priority" Small="true" /></td>
                            <td><StatusBadge Status="@t.Status.ToString()" Kind="ticket" Small="true" /></td>
                            <td class="num small">@Helpers.Fa.Num(t.MessageCount)</td>
                            <td class="small muted num">@Helpers.Fa.Date(t.UpdatedAt)</td>
                            <td>
                                <div class="table__actions">
                                    <a class="icon-btn" style="width:30px;height:30px" href="/dashboard/tickets/@t.Id" title="مشاهده و پاسخ"><Icon Name="eye" Size="14" /></a>
                                    @if (t.Status != TicketStatus.Resolved && t.Status != TicketStatus.Closed)
                                    {
                                        <button class="icon-btn" style="width:30px;height:30px" title="علامت‌زدن به‌عنوانِ حل‌شده" @onclick="() => Resolve(t)">
                                            <Icon Name="check" Size="14" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Meta="paged.Meta" OnPage="Go" />
    }
</div>

@code {
    private Paged<TicketDto>? paged;
    private string search = "";
    private TicketStatus? status;
    private int page = 1;
    private System.Threading.CancellationTokenSource? debounce;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload() =>
        paged = await Api.GetTicketsAsync(page, 12, status?.ToString(), string.IsNullOrWhiteSpace(search) ? null : search.Trim());

    private async Task OnSearch()
    {
        debounce?.Cancel();
        debounce = new System.Threading.CancellationTokenSource();
        var token = debounce.Token;
        try { await Task.Delay(320, token); page = 1; await Reload(); StateHasChanged(); }
        catch (TaskCanceledException) { }
    }

    private async Task Pick(TicketStatus? s) { status = s; page = 1; await Reload(); }

    private async Task Go(int p) { page = p; await Reload(); }

    private async Task Resolve(TicketDto t)
    {
        await Api.AddTicketMessageAsync(t.Id, "درخواست شما بررسی و حل‌شده اعلام شد. در صورت نیاز می‌توانید دوباره آن را باز کنید.", TicketStatus.Resolved);
        Toast.Push("حل‌شده اعلام شد", t.Reference, ToastTone.Ok);
        await Reload();
    }
}
