@page "/dashboard/admin/reviews"
@layout Shared.Layout.DashboardLayout
@inject Services.IStoreApi Api
@inject Services.ToastService Toast

<PageTitle>مدیریت دیدگاه‌ها — فروغ آریا پارسیان</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">مدیریت دیدگاه‌ها</h1>
        <p class="page-sub">@(paged is null ? "…" : Helpers.Fa.Num(paged.Meta.TotalCount) + " دیدگاه در این دسته")</p>
    </div>
</div>

<div class="toolbar">
    <Segmented TValue="string" Size="sm" Items="@tabs" Value="@filter" ValueChanged="OnFilterChanged" />
    <div class="search" style="flex:1;max-width:280px">
        <span class="search__icon"><Icon Name="search" Size="16" /></span>
        <input class="input" placeholder="جست‌وجو در متن…" @bind="search" @bind:event="oninput" @onkeyup="OnSearch" />
    </div>
</div>

<div class="stack-4" style="margin-top:var(--sp-5)">
    @if (paged is null)
    {
        @for (var i = 0; i < 3; i++) { <Skeleton Kind="card" /> }
    }
    else if (Rows.Count() == 0)
    {
        <EmptyState Icon="star" Title="دیدگاهی با این فیلتر نیست" />
    }
    else
    {
        @foreach (var r in Rows)
        {
            <div class="card card--pad">
                <div class="between" style="align-items:flex-start;gap:var(--sp-4)">
                    <div style="flex:1;min-width:0">
                        <div class="row-3" style="margin-bottom:var(--sp-2);flex-wrap:wrap">
                            <Stars Value="@r.Rating" Size="14" />
                            <span class="strong">@r.Title</span>
                            <StatusBadge Status="@r.Status.ToString()" Kind="review" Small="true" />
                        </div>
                        <p class="muted" style="margin:0 0 var(--sp-3);line-height:1.85">@r.Body</p>
                        <div class="row-3 tiny muted" style="flex-wrap:wrap">
                            <span>@r.AuthorName</span>
                            <span>·</span>
                            <span class="num">@Helpers.Fa.Date(r.CreatedAt)</span>
                            <span>·</span>
                            <span>@(r.ProductName ?? "—")</span>
                            @if (!string.IsNullOrWhiteSpace(r.AuthorCompany))
                            {
                                <span>·</span>
                                <span>@r.AuthorCompany</span>
                            }
                        </div>
                    </div>
                    <div class="col-2" style="width:132px;flex:none">
                        @if (r.Status != ReviewStatus.Approved)
                        {
                            <button class="btn btn--primary btn--xs" @onclick="() => Moderate(r, ReviewStatus.Approved)">
                                <Icon Name="check" Size="13" /> تأیید
                            </button>
                        }
                        @if (r.Status != ReviewStatus.Rejected)
                        {
                            <button class="btn btn--secondary btn--xs" @onclick="() => Moderate(r, ReviewStatus.Rejected)">
                                <Icon Name="x" Size="13" /> رد
                            </button>
                        }
                        <button class="btn btn--ghost btn--xs" style="color:var(--bad-600)" @onclick="() => Remove(r)">
                            <Icon Name="trash" Size="13" /> حذف
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (paged is { Meta.TotalPages: > 1 })
{
    <Pager Meta="@paged.Meta" OnPage="Go" />
}

@code {
    private Paged<ReviewDto>? paged;
    private string filter = "Pending";
    private string search = "";
    private int current = 1;

    private IReadOnlyList<SegItem<string>> tabs => new[]
    {
        new SegItem<string>("در صف بررسی", "Pending"),
        new SegItem<string>("تأییدشده", "Approved"),
        new SegItem<string>("ردشده", "Rejected"),
        new SegItem<string>("همه", "all"),
    };

    private IEnumerable<ReviewDto> Rows => (paged?.Items ?? Array.Empty<ReviewDto>())
        .Where(r => search.Trim().Length == 0
                 || r.Body.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                 || r.Title.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                 || r.AuthorName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        ReviewStatus? status = filter == "all" ? null : Enum.Parse<ReviewStatus>(filter);
        paged = await Api.GetReviewsAsync(current, 10, null, status);
    }

    private Task Go(int p) { current = p; return Load(); }
    private Task OnFilterChanged(string? v) { filter = v ?? "all"; current = 1; return Load(); }
    private Task OnSearch(KeyboardEventArgs e) => e.Key == "Enter" ? Go(1) : Task.CompletedTask;

    private async Task Moderate(ReviewDto r, ReviewStatus next)
    {
        await Api.ModerateReviewAsync(r.Id, next);
        Toast.Push(next == ReviewStatus.Approved ? "دیدگاه تأیید شد" : "دیدگاه رد شد",
                   r.Title, next == ReviewStatus.Approved ? ToastTone.Ok : ToastTone.Info);
        await Load();
    }

    private async Task Remove(ReviewDto r)
    {
        await Api.DeleteReviewAsync(r.Id);
        Toast.Push("دیدگاه حذف شد", r.Title, ToastTone.Info);
        await Load();
    }
}
