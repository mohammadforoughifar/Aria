@page "/dashboard/admin/licenses"
@layout Components.Layout.DashboardLayout
@inject Services.IStoreApi Api
@inject Services.ToastService Toast

<PageTitle>مدیریت لایسنس‌ها — فروغ آریا پارسیان</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">لایسنس‌ها</h1>
        <p class="page-sub">@(paged is null ? "…" : Helpers.Fa.Num(paged.Meta.TotalCount) + " کلید")</p>
    </div>
    @* صدورِ دستی برداشته شد: کلید فقط با خریدِ مشتری ساخته می‌شود.
       این صفحه فقط برایِ دید و پشتیبانی (تمدید/ابطال) است. *@
    <div class="chip" title="کلید پس از پرداختِ سفارش، خودکار برایِ مشتری صادر می‌شود.">
        <Icon Name="key" Size="14" /> صدور خودکار پس از خرید
    </div>
</div>

<div class="toolbar">
    <div class="search" style="flex:1;max-width:320px">
        <span class="search__icon"><Icon Name="search" Size="16" /></span>
        <input class="input" placeholder="کلید، مشتری یا محصول…" @bind="search" @bind:event="oninput" @onkeyup="OnSearch" />
    </div>
    <Segmented TValue="string" Size="sm" Items="@statusTabs" Value="@status" ValueChanged="OnStatusChanged" />
</div>

<div class="card table-wrap" style="margin-top:var(--sp-4)">
    @if (paged is null)
    {
        <div style="padding:var(--sp-4)">
            @for (var i = 0; i < 6; i++) { <Skeleton Kind="row" /> }
        </div>
    }
    else if (paged.Items.Count == 0)
    {
        <EmptyState Icon="key" Title="لایسنسی یافت نشد" />
    }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr><th>محصول</th><th>دارنده</th><th>کلید</th><th>فعال‌سازی</th><th>انقضا</th><th>وضعیت</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var l in paged.Items)
                    {
                        <tr>
                            <td>
                                <div class="strong">@l.ProductName</div>
                                <div class="tiny muted">@(l.PlanName ?? "—")</div>
                            </td>
                            <td>
                                <div class="small">@(l.UserName ?? "—")</div>
                                <div class="tiny muted num--lat">@l.UserEmail</div>
                            </td>
                            <td><CopyButton Value="@l.LicenseKey" /></td>
                            <td style="min-width:120px">
                                <div class="tiny num muted">@Helpers.Fa.Num(l.ActivationsUsed) از @Helpers.Fa.Num(l.Seats)</div>
                                <Meter Value="@l.ActivationsUsed" Max="@l.Seats" />
                            </td>
                            <td class="num small muted">@(l.ExpiresAt is null ? "نامحدود" : Helpers.Fa.Date(l.ExpiresAt))</td>
                            <td><StatusBadge Status="@l.Status.ToString()" Kind="license" Small="true" /></td>
                            <td>
                                <div class="table__actions">
                                    <button class="btn btn--ghost btn--xs" @onclick="() => Extend(l)">تمدید ۹۰ روز</button>
                                    @if (l.Status == LicenseStatus.Active)
                                    {
                                        <button class="btn btn--ghost btn--xs" style="color:var(--bad-600)" @onclick="() => Revoke(l)">ابطال</button>
                                    }
                                    else if (l.Status == LicenseStatus.Revoked)
                                    {
                                        <button class="btn btn--ghost btn--xs" style="color:var(--ok-600)" @onclick="() => Reinstate(l)">بازگردانی</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (paged is { Meta.TotalPages: > 1 })
{
    <Pager Meta="@paged.Meta" OnPage="Go" />
}


@code {
    private Paged<LicenseDto>? paged;

    private string search = "", status = "all";
    private int current = 1;

    private IReadOnlyList<SegItem<string>> statusTabs => new[]
    {
        new SegItem<string>("همه", "all"),
        new SegItem<string>("فعال", "Active"),
        new SegItem<string>("منقضی", "Expired"),
        new SegItem<string>("باطل", "Revoked"),
    };

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        paged = await Api.GetAdminLicensesAsync(current, 12, status == "all" ? null : status,
            string.IsNullOrWhiteSpace(search) ? null : search.Trim());
    }

    private Task Go(int p) { current = p; return Load(); }
    private Task OnStatusChanged(string? v) { status = v ?? "all"; current = 1; return Load(); }
    private Task OnSearch(KeyboardEventArgs e) => e.Key == "Enter" ? Go(1) : Task.CompletedTask;

    private async Task Extend(LicenseDto l)
    {
        await Api.LicenseActionAsync(l.Id, "extend", 90);
        Toast.Push("تمدید شد", $"{l.ProductName} — ۹۰ روز", ToastTone.Ok);
        await Load();
    }

    private async Task Revoke(LicenseDto l)
    {
        await Api.LicenseActionAsync(l.Id, "revoke");
        Toast.Push("لایسنس باطل شد", l.LicenseKey, ToastTone.Info);
        await Load();
    }

    private async Task Reinstate(LicenseDto l)
    {
        await Api.LicenseActionAsync(l.Id, "activate");
        Toast.Push("لایسنس بازگردانده شد", l.LicenseKey, ToastTone.Ok);
        await Load();
    }
}
