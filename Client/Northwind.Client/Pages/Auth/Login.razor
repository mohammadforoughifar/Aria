@page "/login"
@inject Services.AuthState Auth
@inject Services.ApiHealth Health
@inject Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>ورود — فروغ آریا پارسیان</PageTitle>

<div class="auth">
    <aside class="auth__aside">
        <div class="brand">
            <span class="brand__mark" style="background:rgba(255,255,255,.18);box-shadow:none">NW</span>
            <span class="brand__name" style="color:#fff">فروغ آریا پارسیان</span>
        </div>
        <h1 class="auth__title">به پورتالِ مشتریان خوش آمدید</h1>
        <p class="auth__lead">
            لایسنس‌ها، فاکتورها، دانلودها و تیکت‌های پشتیبانیِ شما — همه در یک جا،
            با دسترسیِ مستقیم به مهندسانِ هر ماژول.
        </p>
        <div class="auth__points">
            <div class="auth__point"><i><Icon Name="key" Size="12" /></i> صدورِ آنیِ لایسنس پس از پرداخت</div>
            <div class="auth__point"><i><Icon Name="file" Size="12" /></i> بایگانیِ کاملِ فاکتورها</div>
            <div class="auth__point"><i><Icon Name="headphones" Size="12" /></i> رشتهٔ گفت‌وگوی پیوسته با پشتیبانی</div>
        </div>
    </aside>

    <section class="auth__panel">
        <div class="auth__form">
            <div class="auth__head">
                <h1 class="auth__h">ورود به حساب</h1>
                <p class="auth__p">ایمیل و رمز عبورِ خود را وارد کنید.</p>
            </div>

            <label class="field">
                <span class="field__label">ایمیل</span>
                <div class="input-group">
                    <span class="input-group__icon"><Icon Name="mail" Size="16" /></span>
                    <input class="input input--ltr" style="padding-right:var(--sp-9);text-align:left"
                           placeholder="name@company.com" @bind="email" @onkeyup="OnKey" />
                </div>
            </label>

            <label class="field">
                <span class="field__label">رمز عبور</span>
                <div class="input-group">
                    <span class="input-group__icon"><Icon Name="lock" Size="16" /></span>
                    <input class="input input--ltr" style="padding-right:var(--sp-9);text-align:left"
                           type="@(show ? "text" : "password")" @bind="password" @onkeyup="OnKey" />
                    <button type="button" class="input-group__tail" @onclick="() => show = !show"
                            style="background:none;border:0;cursor:pointer;color:var(--text-4)">
                        <Icon Name="@(show ? "eye" : "lock")" Size="16" />
                    </button>
                </div>
            </label>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="badge badge--bad" style="height:auto;padding:8px 12px;justify-content:flex-start">
                    <Icon Name="alert" Size="13" /> @error
                </div>
            }

            <div class="between">
                <label class="check"><input type="checkbox" @bind="remember" /> مرا به خاطر بسپار</label>
                <a class="small" href="/support">رمز را فراموش کرده‌ام</a>
            </div>

            <button class="btn btn--primary btn--lg btn--block" @onclick="Submit" disabled="@busy">
                @if (busy) { <span class="btn__spinner"></span> <span>در حال ورود…</span> }
                else { <span>ورود</span> <Icon Name="arrow-left" Size="16" /> }
            </button>

            <p class="auth__alt">حساب ندارید؟ <a href="/register">ثبت‌نام کنید</a></p>

            <div class="auth__demo">
                <div class="heavy" style="font-size:var(--fs-xs)">حساب‌های دمو (رمز: <code>Password123!</code>)</div>
                <div class="row-2" style="flex-wrap:wrap;margin-top:6px">
                    <button class="chip chip--filter" @onclick='() => LoginAs("admin@northwindsoft.example")'>ورود به‌عنوان ادمین</button>
                    <button class="chip chip--filter" @onclick='() => LoginAs("casey.demo@example.com")'>ورود به‌عنوان مشتری</button>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;
    private bool remember = true;
    private bool show;

    private string ReturnUrl => Helpers.QueryString.Get(Nav.Uri, "returnUrl") ??
                                (Helpers.QueryString.Get(Nav.Uri, "redirect") ?? "/dashboard");

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Submit(); }

    private async Task Submit()
    {
        error = null;
        if (!email.Contains('@') || password.Length < 6)
        {
            error = "ایمیل معتبر و رمز عبور با حداقل ۶ نویسه وارد کنید.";
            return;
        }

        busy = true;
        var ok = await Auth.LoginAsync(email, password);
        busy = false;

        if (!ok)
        {
            // پیام را خودِ سرور می‌دهد و همان یک پیام برایِ «رمزِ اشتباه» و
            // «ایمیلِ ناشناس» است تا معلوم نشود کدام ایمیل ثبت شده است.
            error = Auth.LastError
                ?? (Health.Reachable
                    ? "ورود انجام نشد."
                    : "ارتباط با سرور برقرار نیست، بنابراین ورود بررسی نشد.");
            return;
        }

        Toast.Push("خوش آمدید", Auth.User?.FullName, ToastTone.Ok);
        Nav.NavigateTo(ReturnUrl, forceLoad: false);
    }

    private async Task LoginAs(string demoEmail)
    {
        email = demoEmail;
        password = "Password123!";
        await Submit();
    }
}
