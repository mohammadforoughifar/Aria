@page "/training"
@inject Services.IStoreApi Api

<PageTitle>آموزش — فروغ آریا پارسیان</PageTitle>

<section class="hero">
    <div class="wrap hero__inner">
        <span class="hero__eyebrow"><b>آکادمیِ فروغ آریا پارسیان</b> آموزشِ کاربردی، نه تئوری</span>
        <h1 class="hero__title">یاد بگیرید، <span>به‌کار ببندید</span></h1>
        <p class="hero__sub">
            دوره‌های آموزشی برای کاربران، مدیران و پرسنلِ مالی — حضوری در محل،
            آنلاین یا از طریقِ ویدیوهای ضبط‌شده.
        </p>
        <div class="hero__cta">
            <a class="btn btn--buy btn--lg" href="/contact"><Icon Name="calendar" Size="18" /> رزروِ دوره</a>
            <a class="btn btn--outline-light btn--lg" href="#courses"><Icon Name="play" Size="18" /> دیدنِ دوره‌ها</a>
        </div>
    </div>
</section>

<section class="section section--tight" id="courses">
    <div class="wrap">
        <div class="section__head">
            <div class="section__eyebrow">دوره‌ها</div>
            <h2 class="section__title">مسیرهای آموزشی</h2>
        </div>

        <div class="grid-3">
            @foreach (var c in courses)
            {
                <div class="card card--pad card--hover" style="display:flex;flex-direction:column;gap:var(--sp-3)">
                    <div class="row-2" style="align-items:center;gap:var(--sp-3)">
                        <span class="stat__icon" style="background:#eff6ff;color:#2563eb"><Icon Name="@c.Icon" Size="19" /></span>
                        <div>
                            <b>@c.Title</b>
                            <div class="tiny muted">@c.Level</div>
                        </div>
                    </div>
                    <p class="small muted" style="margin:0;line-height:1.85">@c.Desc</p>
                    <div class="feat-list" style="margin-top:var(--sp-2)">
                        @foreach (var t in c.Topics)
                        {
                            <div class="feat"><span class="feat__check"><Icon Name="check" Size="12" /></span>@t</div>
                        }
                    </div>
                    <div class="row-2 tiny muted" style="margin-top:auto;gap:var(--sp-3);border-top:1px solid var(--line);padding-top:var(--sp-3)">
                        <span><Icon Name="clock" Size="13" /> @Helpers.Fa.Num(c.Hours) ساعت</span>
                        <span><Icon Name="users" Size="13" /> @c.Mode</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section--sunk">
    <div class="wrap">
        <div class="section__head">
            <div class="section__eyebrow">شیوهٔ برگزاری</div>
            <h2 class="section__title">هر شکلی که برای تیمِ شما بهتر است</h2>
        </div>
        <div class="grid-3">
            <div class="card card--pad">
                <span class="stat__icon" style="background:#ecfdf5;color:#059669"><Icon Name="monitor" Size="19" /></span>
                <b style="display:block;margin:var(--sp-3) 0 var(--sp-2)">آنلاینِ زنده</b>
                <p class="small muted" style="margin:0;line-height:1.85">کلاسِ تعاملی با امکانِ پرسش و پاسخ و تمرینِ هم‌زمان.</p>
            </div>
            <div class="card card--pad">
                <span class="stat__icon" style="background:#fff7ed;color:#ea580c"><Icon Name="users" Size="19" /></span>
                <b style="display:block;margin:var(--sp-3) 0 var(--sp-2)">حضوری در محل</b>
                <p class="small muted" style="margin:0;line-height:1.85">آموزش روی دادهٔ واقعیِ شما، در محلِ شرکت.</p>
            </div>
            <div class="card card--pad">
                <span class="stat__icon" style="background:#f5f3ff;color:#7c3aed"><Icon Name="play" Size="19" /></span>
                <b style="display:block;margin:var(--sp-3) 0 var(--sp-2)">ویدیوهای ضبط‌شده</b>
                <p class="small muted" style="margin:0;line-height:1.85">دسترسیِ همیشگی برای استخدامِ نیروی جدید و مرورِ مطالب.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="card card--pad-lg" style="background:linear-gradient(135deg,var(--navy-900),var(--navy-700));border:0;color:#fff;text-align:center">
            <h2 style="color:#fff;font-size:var(--fs-3xl)">یک دورهٔ اختصاصی برای تیمِ خود می‌خواهید؟</h2>
            <p style="color:rgba(255,255,255,.82);margin-top:12px;max-width:60ch;margin-inline:auto;line-height:var(--lh-relax)">
                سرفصل‌ها را با نیازِ شما تنظیم می‌کنیم.
            </p>
            <div class="row-3" style="justify-content:center;margin-top:24px;flex-wrap:wrap">
                <a class="btn btn--buy btn--lg" href="/contact"><Icon Name="mail" Size="18" /> درخواستِ دوره</a>
                <a class="btn btn--outline-light btn--lg" href="/support">مرکز پشتیبانی</a>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly Course[] courses =
    {
        new("آموزشِ مقدماتیِ کاربران", "مبتدی", "calculator",
            "ورودِ اطلاعاتِ پایه، صدورِ فاکتور و کار با کارتابلِ روزانه.",
            new[] { "آشنایی با محیط", "تعریفِ اشخاص و کالا", "صدورِ فاکتور", "گزارش‌های روزانه" }, 8, "حضوری / آنلاین"),
        new("آموزشِ حسابداری و مالی", "متوسط", "receipt",
            "ثبتِ اسناد، سرفصل‌ها و تهیهٔ گزارش‌های مالی و مالیاتی.",
            new[] { "کدینگ و سرفصل‌ها", "اسنادِ حسابداری", "گزارشِ سود و زیان", "اعلامیه‌های مالیاتی" }, 16, "حضوری / آنلاین"),
        new("مدیریتِ انبار و بازرگانی", "متوسط", "boxes",
            "کنترلِ موجودی، رسید و حواله و گردشِ کالا در چند انبار.",
            new[] { "تعریفِ انبار", "رسید و حواله", "انبارگردانی", "گزارشِ گردشِ کالا" }, 12, "حضوری / آنلاین"),
        new("گزارش‌سازی و تحلیل", "پیشرفته", "chart",
            "ساختِ گزارش‌های مدیریتی و داشبورد برای تصمیم‌گیری.",
            new[] { "گزارش‌ساز", "داشبوردِ مدیریتی", "خروجیِ اکسل", "اتصال به هوشِ تجاری" }, 10, "آنلاین"),
        new("مدیریتِ تولید", "پیشرفته", "server",
            "فرمولِ تولید، برنامه‌ریزی و محاسبهٔ بهای تمام‌شده.",
            new[] { "BOM و فرمول", "برنامه‌ریزیِ تولید", "بهای تمام‌شده", "کنترلِ ضایعات" }, 14, "حضوری"),
        new("آموزشِ مدیران", "مدیریتی", "award",
            "آنچه یک مدیر باید از سیستم بخواهد: شاخص‌ها و کنترل‌ها.",
            new[] { "شاخص‌های کلیدی", "کنترل‌های داخلی", "تفکیکِ وظایف", "خلاصهٔ مدیریتی" }, 6, "آنلاین"),
    };

    private sealed record Course(string Title, string Level, string Icon, string Desc,
                                 string[] Topics, int Hours, string Mode);
}
