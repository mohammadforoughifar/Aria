@page "/legal/{slug}"

<PageTitle>@Title — فروغ آریا پارسیان</PageTitle>

<div class="wrap" style="padding-block:var(--sp-9)">
    <div class="breadcrumb" style="margin-bottom:var(--sp-4)">
        <a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>قوانین</span>
    </div>

    <div class="grid-1-2" style="align-items:start">
        <aside class="card card--pad" style="position:sticky;top:calc(var(--header-h) + 16px)">
            <div class="section__eyebrow" style="margin-bottom:var(--sp-3)">اسنادِ حقوقی</div>
            <div class="stack-2">
                @foreach (var d in docs)
                {
                    <a class="side__link @(Slug == d.Slug ? "is-active" : "")" href="/legal/@d.Slug">
                        <span class="side__icon"><Icon Name="file" Size="16" /></span> @d.Title
                    </a>
                }
            </div>
            <div class="divider" style="margin-block:var(--sp-4)"></div>
            <p class="tiny muted">آخرین به‌روزرسانی: @Helpers.Fa.Date(new DateTime(2025, 9, 1))</p>
        </aside>

        <article class="card card--pad-lg legal-body">
            <h1 style="font-size:var(--fs-2xl);margin-bottom:var(--sp-2)">@Title</h1>
            <p class="small muted" style="margin-bottom:var(--sp-5)">@Intro</p>

            @foreach (var block in Sections)
            {
                <h3>@block.Heading</h3>
                @foreach (var para in block.Paragraphs)
                {
                    <p>@para</p>
                }
            }

            <div class="divider" style="margin-block:var(--sp-6)"></div>
            <p class="small muted">
                سؤالی دربارهٔ این سند دارید؟
                <a href="/contact">با ما در تماس باشید</a>.
            </p>
        </article>
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "terms";

    private static readonly IReadOnlyList<(string Slug, string Title)> docs = new[]
    {
        ("terms", "شرایط استفاده"),
        ("privacy", "حریم خصوصی"),
        ("license", "قرارداد لایسنس"),
        ("refund", "سیاست بازگشت وجه"),
    };

    private Doc Current => Slug switch
    {
        "privacy" => Privacy,
        "license" => License,
        "refund" => Refund,
        _ => Terms,
    };

    private string Title => docs.FirstOrDefault(d => d.Slug == Slug).Title ?? "شرایط استفاده";
    private string Intro => Current.Intro;
    private IReadOnlyList<Section> Sections => Current.Sections;

    private sealed record Section(string Heading, string[] Paragraphs);
    private sealed record Doc(string Intro, IReadOnlyList<Section> Sections);

    private static readonly Doc Terms = new(
        "این سند، شرایطِ استفاده از وب‌سایت و محصولاتِ فروغ آریا پارسیان را مشخص می‌کند. با خرید یا استفاده از هر یک از محصولات، این شرایط را پذیرفته‌اید.",
        new[]
        {
            new Section("تعریف‌ها", new[]{
                "«فروغ آریا پارسیان» به شخصیتِ حقوقیِ ارائه‌دهندهٔ محصولات اشاره دارد و «مشتری» به شخص یا سازمانی که لایسنس را خریداری کرده است.",
                "«محصول» شامل ماژول‌های ERP، برنامه‌های دسکتاپ، افزونه‌ها و هر به‌روزرسانیِ ارائه‌شده در دورهٔ پشتیبانی است.",
            }),
            new Section("صدور لایسنس", new[]{
                "لایسنس‌های دائمی برای تعدادِ مشخصی از کاربران یا دستگاه‌ها صادر می‌شوند و قابلِ انتقال به شخصِ ثالث نیستند، مگر با اجازهٔ کتبی.",
                "اشتراک‌های سالانه با پایانِ دوره به‌طور خودکار تمدید نمی‌شوند؛ تمدید با صدور فاکتور و تأییدِ مشتری انجام می‌گیرد.",
            }),
            new Section("محدودیت‌ها", new[]{
                "مهندسیِ معکوس، تغییرِ کد یا حذفِ نشانه‌های مالکیت مجاز نیست.",
                "استفادهٔ همزمان بیش از تعدادِ صندلی‌های خریداری‌شده، نقضِ قرارداد محسوب می‌شود.",
            }),
            new Section("مسئولیت", new[]{
                "مسئولیتِ فروغ آریا پارسیان در هر حال از مبلغِ پرداختیِ مشتری در دوازده ماهِ گذشته تجاوز نمی‌کند.",
                "فروغ آریا پارسیان مسئولِ خساراتِ غیرمستقیم — از جمله از دست رفتنِ سود یا توقفِ عملیات — ناشی از استفاده یا عدمِ امکانِ استفاده از محصول نیست.",
            }),
            new Section("تغییرات", new[]{
                "فروغ آریا پارسیان می‌تواند این شرایط را به‌روزرسانی کند. نسخهٔ جدید از تاریخِ انتشار لازم‌الاجراست و مشتریان از طریقِ ایمیل مطلع می‌شوند.",
            }),
        });

    private static readonly Doc Privacy = new(
        "ما تنها داده‌ای را جمع‌آوری می‌کنیم که برای ارائهٔ محصول و پشتیبانی لازم است — و هیچ‌گاه آن را نمی‌فروشیم.",
        new[]
        {
            new Section("چه داده‌هایی جمع می‌کنیم", new[]{
                "اطلاعاتِ حساب: نام، ایمیلِ کاری، شرکت، کشور و شمارهٔ تماس.",
                "اطلاعاتِ استفاده: نسخهٔ محصول، زمانِ آخرین ورود و گزارش‌های خطا برای بهبودِ کیفیت.",
                "اطلاعاتِ مالی: شمارهٔ فاکتور و مبالغ؛ شمارهٔ کارت نزدِ ما ذخیره نمی‌شود.",
            }),
            new Section("محلِ نگهداریِ داده", new[]{
                "دادهٔ محصولات روی زیرساختِ خودِ مشتری است. تنها داده‌های مربوط به حساب و لایسنس در سرورهای فروغ آریا پارسیان نگهداری می‌شود.",
                "سرورها در منطقهٔ اقتصادیِ اروپا مستقرند و پشتیبان‌گیری به‌صورت رمزنگاری‌شده انجام می‌شود.",
            }),
            new Section("دسترسی و حذف", new[]{
                "هر زمان می‌توانید از پورتال، نسخه‌ای از داده‌های خود را دریافت کنید یا حذفِ حساب را درخواست دهید.",
                "داده‌های مالیاتی به‌موجبِ قانون تا پایانِ دورهٔ نگهداریِ قانونی باقی می‌مانند.",
            }),
        });

    private static readonly Doc License = new(
        "این قرارداد، دامنهٔ استفاده از نرم‌افزار را پس از خرید مشخص می‌کند.",
        new[]
        {
            new Section("دامنهٔ استفاده", new[]{
                "لایسنسِ تک‌کاربره برای یک کاربرِ نامی روی هر تعداد دستگاه است، مشروط بر استفادهٔ غیرهمزمان.",
                "لایسنس‌های چندکاربره بر اساسِ تعدادِ کاربرانِ نامی صادر می‌شوند، نه تعدادِ دستگاه‌ها.",
            }),
            new Section("فعال‌سازی", new[]{
                "هر لایسنس به تعدادِ صندلی‌های خود «فعال‌سازی» دارد. فعال‌سازیِ دستگاهِ جدید پس از پر شدنِ سقف، نیازمندِ آزادسازیِ یک دستگاه است.",
                "امکانِ انتقالِ فعال‌سازی از پورتالِ مشتری فراهم است.",
            }),
            new Section("به‌روزرسانی و پشتیبانی", new[]{
                "لایسنس‌های دائمی شامل ۱۲ ماه به‌روزرسانی و پشتیبانی هستند و پس از آن قابلِ تمدیدند.",
                "اشتراک‌های سالانه در طولِ دوره، به‌روزرسانی و پشتیبانیِ نامحدود دارند.",
            }),
        });

    private static readonly Doc Refund = new(
        "اگر محصول انتظارِ شما را برآورده نکرد، تا ۳۰ روز پس از خرید مبلغ را کامل بازمی‌گردانیم.",
        new[]
        {
            new Section("شرایط", new[]{
                "درخواست باید در ۳۰ روزِ نخست پس از خرید و از طریقِ تیکت ثبت شود.",
                "اشتراک‌های سالانه در صورتِ استفادهٔ کمتر از ۱۴ روز، به‌طور کامل مسترد می‌شوند.",
            }),
            new Section("روند", new[]{
                "پس از تأیید، مبلغ ظرفِ ۱۰ روزِ کاری به همان روشِ پرداخت بازگردانده می‌شود.",
                "با بازگشتِ وجه، لایسنس‌ها باطل و دسترسیِ دانلود غیرفعال می‌شود.",
            }),
            new Section("استثناها", new[]{
                "خدماتِ سفارشی‌سازی و مهاجرتِ داده که انجام شده باشند، غیرقابلِ استردادند.",
                "تخفیف‌های اعمال‌شده به نسبت در مبلغِ استرداد لحاظ می‌شوند.",
            }),
        });
}
