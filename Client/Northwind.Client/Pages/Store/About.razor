@page "/about"
@inject Services.IStoreApi Api

<PageTitle>دربارهٔ ما — فروغ آریا پارسیان</PageTitle>

<!-- ===== Hero ===== -->
<section class="hero" style="padding-block:var(--sp-11) var(--sp-9)">
    <div class="wrap hero__inner">
        <span class="hero__eyebrow"><b>از ۱۳۸۸</b> مستقر در روتردام و تهران</span>
        <h1 class="hero__title">ما نرم‌افزارِ کسب‌وکار را <span>ساده‌تر</span> نوشتیم</h1>
        <p class="hero__sub">
            فروغ آریا پارسیان یک تیمِ مهندسی است که یک کار انجام می‌دهد: نرم‌افزاری که شرکت‌های متوسط
            بتوانند واقعاً راه‌اندازی کنند، بفهمند و سال‌ها روی آن حساب کنند.
        </p>
    </div>
</section>

<!-- ===== Numbers ===== -->
<section class="section section--tight">
    <div class="wrap">
        <div class="stat-grid">
            <StatCard Label="سازمانِ مشتری" Value="@Helpers.Fa.Num(480)" Icon="building" Hint="در ۱۴ کشور" />
            <StatCard Label="ماژولِ یکپارچه" Value="@Helpers.Fa.Num(10)" Icon="package" Hint="روی یک هستهٔ داده" />
            <StatCard Label="نرخ تمدید" Value="@(Helpers.Fa.Num(98) + "٪")" Icon="trending-up" Tone="ok" Hint="در سه سال گذشته" />
            <StatCard Label="زمان پاسخِ پشتیبانی" Value="@(Helpers.Fa.Num(4) + " ساعت")" Icon="headphones" Tone="violet" Hint="در روزهای کاری" />
        </div>
    </div>
</section>

<!-- ===== Story ===== -->
<section class="section">
    <div class="wrap grid-1-2">
        <div>
            <div class="section__eyebrow">داستان ما</div>
            <h2 class="section__title" style="margin-top:8px">از یک پروژهٔ جانبی تا یک مجموعهٔ کامل</h2>
        </div>
        <div class="stack-4">
            <p style="color:var(--text-2);line-height:var(--lh-relax)">
                فروغ آریا پارسیان از دلِ یک پروژهٔ مهاجرتِ داده شروع شد: تیمی از حسابداران و مهندسان که خسته از
                مغایرت‌گیریِ دستی بین پنج سیستمِ جدا، تصمیم گرفتند یک هستهٔ تراکنشیِ واحد بنویسند.
                آن هسته امروز قلبِ مجموعهٔ ماست.
            </p>
            <p style="color:var(--text-2);line-height:var(--lh-relax)">
                ما عمداً رشد نکردیم به هر قیمتی. ده ماژول داریم، نه صد تا؛ و هر ماژول را تا زمانی که
                در حسابرسیِ واقعیِ مشتریان تأیید نشده، منتشر نمی‌کنیم.
            </p>
        </div>
    </div>
</section>

<!-- ===== Principles ===== -->
<section class="section section--sunk">
    <div class="wrap">
        <div class="section__head">
            <div class="section__eyebrow">اصولِ کاری</div>
            <h2 class="section__title">چهار قولی که به مشتریان‌مان می‌دهیم</h2>
        </div>

        <div class="grid-2">
            @foreach (var p in principles)
            {
                <div class="card card--pad card--hover row-top" style="gap:var(--sp-4)">
                    <span class="stat__icon" style="width:38px;height:38px"><Icon Name="@p.Icon" Size="18" /></span>
                    <div>
                        <h3 style="font-size:var(--fs-md)">@p.Title</h3>
                        <p class="small muted-2" style="margin-top:6px;line-height:var(--lh-relax)">@p.Text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== Timeline ===== -->
<section class="section">
    <div class="wrap wrap-sm">
        <div class="section__head" style="text-align:center;justify-items:center">
            <div class="section__eyebrow">مسیر</div>
            <h2 class="section__title">ده سال، گام‌به‌گام</h2>
        </div>

        <div class="timeline">
            @foreach (var m in milestones)
            {
                <div class="timeline__item">
                    <span class="timeline__dot timeline__dot--ok"><Icon Name="check" Size="12" /></span>
                    <div class="timeline__body">
                        <div class="between">
                            <span class="timeline__title">@m.Title</span>
                            <span class="tiny muted">@m.Year</span>
                        </div>
                        <p class="small muted" style="margin-top:2px;line-height:var(--lh-snug)">@m.Text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== CTA ===== -->
<section class="section section--sunk">
    <div class="wrap wrap-sm" style="text-align:center">
        <h2 class="section__title">بیایید دربارهٔ نیازِ شما حرف بزنیم</h2>
        <p class="section__sub" style="margin-inline:auto">بدون اسلایدِ فروش — فقط یک گفت‌وگوی فنیِ مفید.</p>
        <div class="row-2" style="justify-content:center;margin-top:var(--sp-5);flex-wrap:wrap">
            <a class="btn btn--primary btn--lg" href="/contact"><Icon Name="calendar" Size="17" /> رزرو گفت‌وگو</a>
            <a class="btn btn--secondary btn--lg" href="/catalog">دیدنِ محصولات</a>
        </div>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<(string Icon, string Title, string Text)> principles = new[]
    {
        ("server", "دادهٔ شما، نزدِ شما", "نصب روی زیرساخت خودتان، بدون ارسالِ داده به سرویسِ ثالث و بدون قفل‌شدگی."),
        ("zap", "زمانِ رسیدن به ارزش، نه زمانِ استقرار", "جادوگرِ نصب و ابزار مهاجرت، پیاده‌سازی را به روز به‌جای ماه می‌رسانند."),
        ("code", "هر چیزی یک API دارد", "هر قابلیتی که در رابط کار می‌کند، از طریق API و با مستنداتِ OpenAPI هم در دسترس است."),
        ("headphones", "پشتیبانی، خودِ مهندسان", "تیکت شما را کسی پاسخ می‌دهد که آن ماژول را نوشته است."),
    };

    private static readonly IReadOnlyList<(string Year, string Title, string Text)> milestones = new[]
    {
        ("۱۳۸۸", "آغاز با یک هستهٔ تراکنشی", "نسخهٔ اولیه برای یک تولیدکنندهٔ قطعه با دو کاربر نوشته شد."),
        ("۱۳۹۱", "ماژولِ مالی", "دفتر کل و تطبیقِ بانکی به مجموعه اضافه شد و نخستین مشتریِ خارجی نصب کرد."),
        ("۱۳۹۵", "لایسنسِ دائمی", "مدلِ فروش به لایسنسِ دائمی تغییر کرد تا هزینهٔ مالکیت پیش‌بینی‌پذیر شود."),
        ("۱۳۹۹", "برنامه‌های دسکتاپ", "CRM و صندوقِ فروشگاهی برای تیم‌هایی که بیرون از دفتر کار می‌کنند منتشر شد."),
        ("۱۴۰۲", "لایهٔ تحلیلی", "کانکتورِ هوش تجاری با لایهٔ معناییِ آماده برای Power BI و Tableau."),
        ("۱۴۰۴", "نسخهٔ ۲۰۲۵٫۲", "موتورِ قواعدِ مغایرت‌گیری، API نسخهٔ ۲ و سازندهٔ داشبوردِ بازطراحی‌شده."),
    };
}
