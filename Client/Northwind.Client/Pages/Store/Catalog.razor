@page "/catalog"
@* ?cat=slug — پیوندِ مستقیم از پنلِ مدیر به یک دستهٔ مشخص *@
@inject Services.IStoreApi Api
@inject Services.CartState Cart
@inject Services.ToastService Toast
@inject Services.JsInterop Js
@inject NavigationManager Nav

<PageTitle>نرم‌افزارها — فروغ آریا پارسیان</PageTitle>

<!-- ====================== ۱. سرصفحهٔ کوتاه (بدونِ اسکرولِ اضافه) ====================== -->
<section class="cat-hero">
    <div class="wrap cat-hero__inner">
        <div class="cat-hero__copy">
            <span class="hero__eyebrow">
                <b>نرم‌افزارها</b>
                هر دسته، چند ماژول؛ خودتان بچینید
            </span>

            <h1 class="cat-hero__title">
                ماژول‌های <span>فروغ آریا پارسیان</span> را بر اساسِ دسته انتخاب کنید
            </h1>

            <p class="cat-hero__sub">
                از ستونِ راست دسته را بزنید، ماژول‌ها را انتخاب کنید و کاربر، شرکتِ اضافه و نسخه‌ها را
                تنظیم کنید؛ قیمت همان لحظه حساب می‌شود.
            </p>
        </div>

        <div class="cat-hero__stats">
            <div class="hero__stat">
                <b class="num">@Helpers.Fa.Num(statModules)</b>
                <span>ماژول قابلِ خرید</span>
            </div>
            <div class="hero__stat">
                <b class="num">@Helpers.Fa.Num(statCategories)</b>
                <span>دستهٔ کاری</span>
            </div>
            <div class="hero__stat">
                <b class="num">@Helpers.Fa.Num(statTrial)</b>
                <span>روز آزمایشی</span>
            </div>
        </div>
    </div>
</section>

<!-- ============ ۲. سازندهٔ ماژول — دسته در راست، ماژول‌ها و امکانات در چپ ============ -->
<section class="section section--tight builder-section" id="configurator">
    <div class="wrap">
        <div class="builder">

            <!-- ---------------- ستونِ راست: گامِ ۱، انتخابِ دسته ---------------- -->
            <aside class="builder__side" aria-label="انتخابِ دستهٔ کسب‌وکار">
                <div class="builder__side-head">
                    <span class="step-badge">۱</span>
                    <div class="grow">
                        <b class="builder__side-title">کدام بخشِ کسب‌وکارتان را سامان می‌دهید؟</b>
                        <div class="tiny muted">دسته را بزنید؛ ماژول‌هایش کنار می‌آید.</div>
                    </div>
                </div>

                @if (categories.Count == 0 && loading)
                {
                    <div class="stack-2">
                        @for (var i = 0; i < 6; i++) { <Skeleton Kind="line" /> }
                    </div>
                }
                else
                {
                    <div class="cat-list" role="tablist" aria-orientation="vertical">
                        @foreach (var cat in categories)
                        {
                            var isActive = activeCategory?.Id == cat.Id;
                            <button class="cat-item @(isActive ? "is-active" : "")"
                                    role="tab" aria-selected="@(isActive ? "true" : "false")"
                                    @onclick="() => SelectCategory(cat)" type="button">
                                <span class="cat-item__icon">
                                    <Icon Name="@(string.IsNullOrWhiteSpace(cat.Icon) ? "package" : cat.Icon)" Size="18" />
                                </span>
                                <span class="cat-item__body">
                                    <b class="cat-item__name">@cat.Name</b>
                                    <span class="cat-item__meta">
                                        @Helpers.Fa.Num(cat.ProductCount) ماژول ·
                                        هر کاربرِ اضافه <span class="num">@Helpers.Fa.Money(cat.Pricing?.PricePerUserToman ?? 0)</span>
                                    </span>
                                </span>
                                <Icon Name="chevron-left" Size="15" Class="cat-item__chev" />
                            </button>
                        }
                    </div>
                }

                <div class="builder__side-tip">
                    <Icon Name="info" Size="13" />
                    <span>قیمت‌هایِ هر دسته را مدیر در پنل تعیین می‌کند؛ همین‌جا اعمال می‌شود.</span>
                </div>
            </aside>

            <!-- ---------------- ستونِ چپ: گامِ ۲، ماژول‌ها و امکاناتِ جانبی ---------------- -->
            <div class="builder__main">
                @if (activeCategory is null)
                {
                    <div class="card">
                        <EmptyState Icon="grid" Title="دسته‌ای انتخاب نشده"
                                    Text="از ستونِ راست، بخشِ کسب‌وکارتان را انتخاب کنید." />
                    </div>
                }
                else
                {
                    <div class="builder__main-head">
                        <span class="step-badge">۲</span>
                        <div class="grow">
                            <div class="builder__main-title">@Helpers.Fa.Num(modules.Count) ماژول در «@activeCategory.Name»</div>
                            <div class="tiny muted">
                                رویِ ماژول بزنید تا انتخاب شود؛ بعد کاربر، شرکتِ اضافه و نسخه‌ها را تنظیم کنید.
                                پیش‌فرض، نسخهٔ دسکتاپ است.
                            </div>
                        </div>

                        @if (OtherSelectedCount() > 0)
                        {
                            <button class="flag flag--brand" type="button"
                                    @onclick='() => Js.ScrollTo("#summary", 96)'
                                    title="دیدنِ خلاصهٔ همهٔ انتخاب‌ها">
                                <Icon Name="check" Size="12" />
                                @Helpers.Fa.Num(OtherSelectedCount()) ماژول از دسته‌هایِ دیگر
                            </button>
                        }
                    </div>

                    @if (modules.Count == 0 && loading)
                    {
                        <div class="mod-list">
                            @for (var i = 0; i < 3; i++) { <Skeleton Kind="card" /> }
                        </div>
                    }
                    else if (modules.Count == 0)
                    {
                        <div class="card">
                            <EmptyState Icon="package" Title="برایِ این دسته ماژولی ثبت نشده"
                                        Text="از پنلِ مدیر، محصولی در این دسته بسازید تا همین‌جا نمایش داده شود." />
                        </div>
                    }
                    else
                    {
                        @* @key باعث می‌شود با تغییرِ دسته، کارت‌ها از نو ساخته شوند و انیمیشنِ ورود اجرا شود *@
                        <div class="mod-list" @key="activeCategory.Id">
                    @for (var mi = 0; mi < modules.Count; mi++)
                    {
                        var m = modules[mi];
                        var sel = SelectionOf(m);
                        var pricing = PricingOf(m);
                        <div class="mod-card card card--pad @(sel is not null ? "card--selected" : "")"
                             style="--i:@mi">
                            <div class="between" style="gap:var(--sp-4);align-items:flex-start;flex-wrap:wrap">
                                <div class="row-3" style="align-items:flex-start">
                                    <button class="pick @(sel is not null ? "is-on" : "")"
                                            @onclick="() => ToggleModule(m)" type="button"
                                            aria-label="@(sel is not null ? "حذفِ ماژول از انتخاب" : "افزودنِ ماژول به انتخاب")">
                                        @if (sel is not null) { <Icon Name="check" Size="14" /> }
                                    </button>

                                    <div>
                                        <div class="row-2" style="gap:var(--sp-2)">
                                            <b>@m.Name</b>
                                            <span class="tag tag--sm">@m.Platform</span>
                                        </div>
                                        <p class="small muted" style="margin:4px 0 6px">@m.Tagline</p>
                                        <div class="row-2" style="gap:var(--sp-2);flex-wrap:wrap">
                                            <span class="flag flag--brand">قیمتِ پایه: <b class="num">@Helpers.Fa.Money(m.BasePriceToman)</b></span>
                                            <span class="flag">دسکتاپ شامل است</span>
                                            @if (m.PlanCount > 0)
                                            {
                                                <span class="flag flag--ok">@Helpers.Fa.Num(m.PlanCount) طرحِ قیمت</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div style="text-align:left;min-width:180px">
                                    <div class="tiny muted">مبلغِ این ماژول</div>
                                    <div class="num" style="font-weight:800;font-size:var(--fs-lg)">
                                        @Helpers.Fa.Money(UnitPriceOf(m))
                                    </div>
                                    @if (sel is not null)
                                    {
                                        <div class="tiny muted" style="margin-top:2px">@SummaryFor(m, sel)</div>
                                    }
                                </div>
                            </div>

                            @if (sel is not null)
                            {
                                @* ---------------- امکاناتِ جانبیِ همین ماژول ---------------- *@
                                <div class="config" style="margin-top:var(--sp-4)">
                                    <div class="config__row">
                                        <div>
                                            <b class="small">تعدادِ کاربر</b>
                                            <div class="tiny muted">
                                                قیمتِ هر کاربرِ اضافه:
                                                <span class="num">@Helpers.Fa.Money(pricing.PricePerUserToman)</span>
                                                @if (pricing.UsersIncluded > 1)
                                                {
                                                    <text> — @Helpers.Fa.Num(pricing.UsersIncluded) کاربر شاملِ قیمتِ پایه</text>
                                                }
                                            </div>
                                        </div>
                                        <div class="stepper">
                                            <button class="stepper__btn" type="button"
                                                    disabled="@(sel.Users <= MinUsersFor(m))"
                                                    @onclick="() => StepUsers(m, sel, -1)">−</button>
                                            <span class="stepper__value num">@Helpers.Fa.Num(sel.Users)</span>
                                            <button class="stepper__btn" type="button"
                                                    disabled="@(sel.Users >= Math.Max(MinUsersFor(m), pricing.MaxUsers))"
                                                    @onclick="() => StepUsers(m, sel, +1)">+</button>
                                        </div>
                                    </div>

                                    <div class="config__row">
                                        <div>
                                            <b class="small">شرکتِ اضافه</b>
                                            <div class="tiny muted">
                                                @if (!pricing.AllowMultiCompany)
                                                {
                                                    <text>نسخهٔ چندشرکتی برایِ این دسته فعال نیست.</text>
                                                }
                                                else
                                                {
                                                    <text>
                                                        هر شرکتِ اضافه <span class="num">@Helpers.Fa.Money(pricing.PricePerExtraCompanyToman)</span>
                                                        — هر شرکت همان @Helpers.Fa.Num(sel.Users) کاربر را دارد
                                                    </text>
                                                }
                                            </div>
                                        </div>
                                        <div class="stepper">
                                            <button class="stepper__btn" type="button"
                                                    disabled="@(!pricing.AllowMultiCompany || sel.ExtraCompanies <= 0)"
                                                    @onclick="() => StepCompanies(m, sel, -1)">−</button>
                                            <span class="stepper__value num">@Helpers.Fa.Num(sel.ExtraCompanies)</span>
                                            <button class="stepper__btn" type="button"
                                                    disabled="@(!pricing.AllowMultiCompany || sel.ExtraCompanies >= pricing.MaxExtraCompanies)"
                                                    @onclick="() => StepCompanies(m, sel, +1)">+</button>
                                        </div>
                                    </div>

                                    <div class="config__row">
                                        <div>
                                            <b class="small">نسخه‌ها</b>
                                            <div class="tiny muted">دسکتاپ همیشه شامل است؛ موبایل افزونه است.</div>
                                        </div>
                                        <div class="row-2" style="gap:var(--sp-2);flex-wrap:wrap">
                                            <span class="flag flag--ok">دسکتاپ <Icon Name="check" Size="12" /></span>

                                            <button class="toggle-chip @(sel.IncludeAndroid ? "is-on" : "")"
                                                    type="button"
                                                    disabled="@(!pricing.AllowMobileAddons || pricing.PriceAndroidToman <= 0)"
                                                    @onclick='() => TogglePlatform(sel, "android")'>
                                                <Icon Name="phone" Size="13" />
                                                اندروید
                                                <span class="num">@Helpers.Fa.Money(pricing.PriceAndroidToman)</span>
                                            </button>

                                            <button class="toggle-chip @(sel.IncludeIos ? "is-on" : "")"
                                                    type="button"
                                                    disabled="@(!pricing.AllowMobileAddons || pricing.PriceIosToman <= 0)"
                                                    @onclick='() => TogglePlatform(sel, "ios")'>
                                                <Icon Name="phone" Size="13" />
                                                iOS
                                                <span class="num">@Helpers.Fa.Money(pricing.PriceIosToman)</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="config__breakdown">
                                        <span>پایهٔ ماژول <b class="num">@Helpers.Fa.Money(m.BasePriceToman)</b></span>
                                        <span>کاربران <b class="num">@Helpers.Fa.Money(UsersCost(m, sel))</b></span>
                                        <span>شرکت‌ها <b class="num">@Helpers.Fa.Money(CompaniesCost(m, sel))</b></span>
                                        <span>موبایل <b class="num">@Helpers.Fa.Money(MobileCost(m, sel))</b></span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                        </div>
                    }

                    @if (selected.Count > 0)
                    {
                        <div class="card card--pad mod-card" id="summary" style="--i:@selected.Count">
                            <div class="between" style="align-items:flex-start;gap:var(--sp-4);flex-wrap:wrap">
                                <div>
                                    <div class="section__eyebrow">گامِ ۳ — خلاصهٔ خرید</div>
                                    <h2 class="section__title" style="margin-top:4px">آنچه انتخاب کرده‌اید</h2>
                                </div>
                                <button class="btn btn--ghost btn--sm" @onclick="ClearSelection" type="button">
                                    <Icon Name="trash" Size="14" /> خالی کردنِ انتخاب
                                </button>
                            </div>

                            <div class="table-wrap" style="margin-top:var(--sp-4)">
                                <div class="table-scroll">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>ماژول</th>
                                                <th>پیکربندی</th>
                                                <th>کاربر</th>
                                                <th>شرکتِ اضافه</th>
                                                <th>نسخه‌ها</th>
                                                <th style="text-align:left">مبلغ</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in SelectedLines())
                                            {
                                                <tr>
                                                    <td>
                                                        <b>@line.Product.Name</b>
                                                        <div class="tiny muted">@line.Product.Platform</div>
                                                    </td>
                                                    <td class="small">@line.Summary</td>
                                                    <td class="num">@Helpers.Fa.Num(line.Selection.Users)</td>
                                                    <td class="num">@Helpers.Fa.Num(line.Selection.ExtraCompanies)</td>
                                                    <td class="small">
                                                        دسکتاپ@(line.Selection.IncludeAndroid ? " + اندروید" : "")@(line.Selection.IncludeIos ? " + iOS" : "")
                                                    </td>
                                                    <td style="text-align:left" class="num">@Helpers.Fa.Money(line.UnitPrice)</td>
                                                    <td>
                                                        <button class="icon-btn" style="width:28px;height:28px;color:var(--bad-600)"
                                                                title="حذف از انتخاب" @onclick="() => RemoveLine(line.Product.Id)" type="button">
                                                            <Icon Name="trash" Size="13" />
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="grid-2" style="gap:var(--sp-5);align-items:start;margin-top:var(--sp-4)">
                                <div class="stack-3">
                                    <p class="small muted" style="margin:0">
                                        مبلغِ بالا پیش از مالیات است؛ مالیات و کدِ تخفیف در صفحهٔ تسویه اعمال می‌شود.
                                        همهٔ مبلغ‌ها را سرور بر اساسِ قیمت‌هایِ تنظیم‌شده در پنلِ مدیر حساب می‌کند.
                                    </p>
                                    @if (quote is not null)
                                    {
                                        <p class="tiny muted" style="margin:0">
                                            <Icon Name="check" Size="12" /> قیمت با سرور تطبیق داده شد
                                            (@Helpers.Fa.Num(quote.ModuleCount) ماژول).
                                        </p>
                                    }
                                </div>

                                <div class="card card--pad" style="background:var(--surface-sunk)">
                                    <div class="between">
                                        <span class="muted">تعدادِ ماژول</span>
                                        <b class="num">@Helpers.Fa.Num(selected.Count)</b>
                                    </div>
                                    <div class="between" style="margin-top:var(--sp-2)">
                                        <span class="muted">جمعِ کل (پیش از مالیات)</span>
                                        <b class="num" style="font-size:var(--fs-lg)">@Helpers.Fa.Money(TotalToman())</b>
                                    </div>

                                    <div class="stack-2" style="margin-top:var(--sp-4)">
                                        <button class="btn btn--primary btn--block" @onclick="AddAllToCart" disabled="@busy" type="button">
                                            @if (busy) { <span class="btn__spinner"></span> } else { <Icon Name="cart" Size="16" /> }
                                            افزودنِ همه به سبد خرید
                                        </button>
                                        <button class="btn btn--buy btn--block" @onclick="PayNow" disabled="@busy" type="button">
                                            <Icon Name="credit-card" Size="16" /> پرداخت و ثبتِ سفارش
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- ==================== ۳. نوارِ خریدِ چسبیده به پایین ==================== -->
@if (selected.Count > 0)
{
    <div class="buy-bar" role="region" aria-label="خلاصهٔ خرید">
        <div class="wrap buy-bar__inner">
            <div class="buy-bar__info">
                <span class="step-badge step-badge--sm">۳</span>
                <div>
                    <b class="num">@Helpers.Fa.Num(selected.Count) ماژول انتخاب شده</b>
                    <div class="buy-bar__total">
                        جمعِ کل (پیش از مالیات):
                        <b class="num">@Helpers.Fa.Money(TotalToman())</b>
                    </div>
                </div>
            </div>

            <div class="buy-bar__actions">
                <button class="btn btn--ghost btn--sm" @onclick='() => Js.ScrollTo("#summary", 96)' type="button">
                    <Icon Name="receipt" Size="14" /> جزئیات
                </button>
                <button class="btn btn--primary btn--sm" @onclick="AddAllToCart" disabled="@busy" type="button">
                    @if (busy) { <span class="btn__spinner"></span> } else { <Icon Name="cart" Size="15" /> }
                    افزودن به سبد
                </button>
                <button class="btn btn--buy btn--sm" @onclick="PayNow" disabled="@busy" type="button">
                    <Icon Name="credit-card" Size="15" /> پرداخت
                </button>
            </div>
        </div>
    </div>
}

<!-- ==================== ۴. پرسش‌های پرتکرار ==================== -->
@if (faqs.Count > 0)
{
    <section class="section section--sunk">
        <div class="wrap wrap-sm">
            <div class="section__head">
                <div class="section__eyebrow">پرسش‌های پرتکرار</div>
                <h2 class="section__title">پیش از خرید، این‌ها را بخوانید</h2>
            </div>

            <div class="faq">
                @foreach (var f in faqs)
                {
                    <div class="faq__item @(openFaq == f.Id ? "is-open" : "")">
                        <button class="faq__q" type="button" @onclick="() => ToggleFaq(f.Id)">
                            @f.Question
                            <Icon Name="chevron-down" Class="faq__chev" Size="17" />
                        </button>
                        @if (openFaq == f.Id)
                        {
                            <div class="faq__a">@f.Answer</div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@* نوارِ خرید چسبیده به پایین است؛ این فاصله نگذارد رویِ فوتر بیفتد *@
@if (selected.Count > 0)
{
    <div class="buy-bar-spacer"></div>
}

@code {
    /* ------------------------------ دادهٔ صفحه ------------------------------ */
    private IReadOnlyList<CategoryDto> categories = Array.Empty<CategoryDto>();
    private IReadOnlyList<CategoryDto> allCategories = Array.Empty<CategoryDto>();
    private IReadOnlyList<ProductListItemDto> modules = Array.Empty<ProductListItemDto>();
    private IReadOnlyList<FaqDto> faqs = Array.Empty<FaqDto>();
    /// <summary>دستهٔ بازشده از نشانیِ صفحه (?cat=slug).</summary>
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "cat")]
    public string? CatSlug { get; set; }

    private CategoryDto? activeCategory;
    private ModuleQuoteDto? quote;

    private string? openFaq;
    private bool loading = true;
    private bool busy;

    /* ------------------------ انتخاب‌هایِ مشتری (به ترتیبِ انتخاب) ------------------------ */
    private sealed class Picked
    {
        public required ProductListItemDto Product { get; set; }
        public int Users { get; set; } = 1;
        public int ExtraCompanies { get; set; }
        public bool IncludeAndroid { get; set; }
        public bool IncludeIos { get; set; }
    }

    private readonly List<Picked> selected = new();


    private const int FallbackTrial = 14;
    private int statModules = 12;
    private int statCategories = 8;
    private int statTrial = FallbackTrial;


    /* ------------------------------ راه‌اندازی ------------------------------ */

    protected override async Task OnInitializedAsync()
    {
        var catTask = Api.GetCategoriesAsync();
        var faqTask = Api.GetFaqsAsync();
        await Task.WhenAll(catTask, faqTask);

        allCategories = await catTask;
        categories = allCategories;
        faqs = (await faqTask).Take(6).ToList();
        openFaq = faqs.FirstOrDefault()?.Id;

        if (categories.Count > 0)
        {
            statCategories = categories.Count;
        }

        // ?cat=slug از پنلِ مدیر می‌آید؛ اگر بود همان دسته باز می‌شود
        activeCategory = (string.IsNullOrWhiteSpace(CatSlug) ? null : categories.FirstOrDefault(c => c.Slug == CatSlug))
                         ?? categories.FirstOrDefault();
        if (activeCategory is not null) await LoadModules(activeCategory);

        loading = false;

        var total = categories.Sum(c => c.ProductCount);
        if (total > 0) statModules = total;

        StateHasChanged();
    }

    private async Task LoadModules(CategoryDto category)
    {
        modules = Array.Empty<ProductListItemDto>();

        // همهٔ ماژول‌هایِ دسته (تا ۵۰ مورد — فهرستِ دسته کوچک است)
        var page = await Api.GetProductsAsync(new ProductQuery
        {
            Page = 1,
            PageSize = 50,
            Category = category.Slug,
            SortBy = "newest"
        });

        modules = page.Items;

    }

    private async Task SelectCategory(CategoryDto category)
    {
        activeCategory = category;
        await Js.ScrollToIfNeeded("#builder-main", 92);
        await LoadModules(category);
        StateHasChanged();
    }

    /* ------------------------------ انتخاب ------------------------------ */

    /// <summary>
    /// قیمتِ امکاناتِ جانبی از آنِ دستهٔ خودِ ماژول است، نه دستهٔ بازِ فعلی؛
    /// بنابراین می‌توان از چند دسته ماژول انتخاب کرد و خلاصه همه را یک‌جا دید.
    /// </summary>
    private CategoryPricingDto PricingOf(ProductListItemDto product)
        => allCategories.FirstOrDefault(c => c.Slug == product.CategorySlug)?.Pricing
           ?? activeCategory?.Pricing
           ?? CategoryPricingDto.Free;

    private int MinUsersFor(ProductListItemDto product) => Math.Max(1, PricingOf(product).UsersIncluded);

    /// <summary>تعدادِ ماژول‌هایی که از دسته‌هایِ دیگر انتخاب شده‌اند (در این ستون دیده نمی‌شوند).</summary>
    private int OtherSelectedCount()
        => selected.Count(x => x.Product.CategorySlug != activeCategory?.Slug);

    private Picked? SelectionOf(ProductListItemDto p)
        => selected.FirstOrDefault(s => s.Product.Id == p.Id);

    private void ToggleModule(ProductListItemDto product)
    {
        var existing = SelectionOf(product);
        if (existing is not null)
        {
            selected.Remove(existing);
        }
        else
        {
            var pricing = PricingOf(product);
            selected.Add(new Picked
            {
                Product = product,
                Users = Math.Max(1, pricing.UsersIncluded),
                ExtraCompanies = 0
            });
        }

        _ = RefreshQuoteAsync();
    }

    private void RemoveLine(string productId)
    {
        var line = selected.FirstOrDefault(s => s.Product.Id == productId);
        if (line is not null) selected.Remove(line);
        _ = RefreshQuoteAsync();
    }

    private void ClearSelection()
    {
        selected.Clear();
        quote = null;
    }

    private void StepUsers(ProductListItemDto product, Picked sel, int delta)
    {
        var pricing = PricingOf(product);
        var min = MinUsersFor(product);
        var max = Math.Max(min, pricing.MaxUsers);
        sel.Users = Math.Clamp(sel.Users + delta, min, max);
        _ = RefreshQuoteAsync();
    }

    private void StepCompanies(ProductListItemDto product, Picked sel, int delta)
    {
        var pricing = PricingOf(product);
        var max = pricing.AllowMultiCompany ? Math.Max(0, pricing.MaxExtraCompanies) : 0;
        sel.ExtraCompanies = Math.Clamp(sel.ExtraCompanies + delta, 0, max);
        _ = RefreshQuoteAsync();
    }

    private void TogglePlatform(Picked sel, string platform)
    {
        if (platform == "android") sel.IncludeAndroid = !sel.IncludeAndroid;
        else sel.IncludeIos = !sel.IncludeIos;
        _ = RefreshQuoteAsync();
    }

    /* --------------------------- محاسبهٔ قیمت ---------------------------
       نمایش فوری از رویِ همان قیمت‌هایِ دسته (که از پایگاه‌داده آمده) انجام
       می‌شود و هم‌زمان قیمتِ رسمی از سرور گرفته می‌شود؛ اگر برگشت، همان
       جای‌گزین می‌شود. سرور هنگامِ افزودن به سبد دوباره حساب می‌کند.        */

    private decimal UsersCost(ProductListItemDto p, Picked sel)
    {
        var pricing = PricingOf(p);
        var included = Math.Max(1, pricing.UsersIncluded);
        return Math.Max(0, sel.Users - included) * Math.Max(0, pricing.PricePerUserToman);
    }

    private decimal CompaniesCost(ProductListItemDto p, Picked sel)
        => Math.Max(0, sel.ExtraCompanies) * Math.Max(0, PricingOf(p).PricePerExtraCompanyToman);

    private decimal MobileCost(ProductListItemDto p, Picked sel)
    {
        var pricing = PricingOf(p);
        return (sel.IncludeAndroid ? Math.Max(0, pricing.PriceAndroidToman) : 0)
             + (sel.IncludeIos ? Math.Max(0, pricing.PriceIosToman) : 0);
    }

    private decimal UnitPriceOf(ProductListItemDto p)
    {
        var sel = SelectionOf(p);
        if (sel is null) return p.BasePriceToman;

        // اگر سرور قیمت داده باشد، همان معتبر است
        var server = quote?.Lines.FirstOrDefault(l => l.ProductId == p.Id);
        if (server is not null) return server.Price.TotalToman;

        return p.BasePriceToman + UsersCost(p, sel) + CompaniesCost(p, sel) + MobileCost(p, sel);
    }

    private decimal TotalToman() => quote?.TotalToman ?? selected.Sum(s => UnitPriceOf(s.Product));

    private string SummaryFor(ProductListItemDto p, Picked sel)
    {
        var server = quote?.Lines.FirstOrDefault(l => l.ProductId == p.Id);
        if (server is not null) return server.Summary;

        var parts = new List<string>
        {
            sel.Users <= MinUsersFor(p) ? "نسخهٔ دسکتاپ، ۱ کاربر" : $"نسخهٔ دسکتاپ، {Helpers.Fa.Num(sel.Users)} کاربر"
        };

        if (sel.ExtraCompanies > 0)
            parts.Add($"{Helpers.Fa.Num(sel.ExtraCompanies)} شرکتِ اضافه (هر شرکت {Helpers.Fa.Num(sel.Users)} کاربر)");

        if (sel.IncludeAndroid) parts.Add("اندروید");
        if (sel.IncludeIos) parts.Add("iOS");

        return string.Join(" • ", parts);
    }

    private sealed record Line(Picked Selection, ProductListItemDto Product, string Summary, decimal UnitPrice);

    private List<Line> SelectedLines() => selected
        .Select(s => new Line(s, s.Product, SummaryFor(s.Product, s), UnitPriceOf(s.Product)))
        .ToList();

    private async Task RefreshQuoteAsync()
    {
        if (selected.Count == 0)
        {
            quote = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var items = selected.Select(s => new ModuleSelectionDto
            {
                ProductId = s.Product.Id,
                Users = s.Users,
                ExtraCompanies = s.ExtraCompanies,
                IncludeAndroid = s.IncludeAndroid,
                IncludeIos = s.IncludeIos
            }).ToList();

            var result = await Api.QuoteModulesAsync(items);
            if (result is not null) quote = result;
        }
        catch
        {
            // قیمتِ محلی همان می‌ماند؛ افزودن به سبد هم دوباره از سرور می‌پرسد.
        }

        await InvokeAsync(StateHasChanged);
    }

    /* ------------------------------ خرید ------------------------------ */

    private async Task<bool> AddAllToCart()
    {
        if (selected.Count == 0) return false;

        busy = true;
        var added = 0;

        foreach (var s in selected.ToList())
        {
            var ok = await Cart.AddConfiguredAsync(new ModuleSelectionDto
            {
                ProductId = s.Product.Id,
                Users = s.Users,
                ExtraCompanies = s.ExtraCompanies,
                IncludeAndroid = s.IncludeAndroid,
                IncludeIos = s.IncludeIos
            });

            if (!ok)
            {
                Toast.Push("افزودن به سبد انجام نشد", Cart.Error ?? "دوباره تلاش کنید.", ToastTone.Bad);
                busy = false;
                return false;
            }

            added++;
        }

        busy = false;
        Toast.Push("به سبد اضافه شد",
            $"{Helpers.Fa.Num(added)} ماژول با همان پیکربندی به سبدِ خرید رفت.", ToastTone.Ok);

        return true;
    }

    private async Task PayNow()
    {
        var ok = await AddAllToCart();
        if (ok) Nav.NavigateTo("/checkout");
    }

    private void ToggleFaq(string id) => openFaq = openFaq == id ? null : id;

    /* ------------------------------ گرافیک ------------------------------ */

}
