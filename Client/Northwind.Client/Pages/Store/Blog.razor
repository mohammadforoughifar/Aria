@page "/blog"
@inject Services.IStoreApi Api
@inject NavigationManager Nav

<PageTitle>وبلاگ و مرکزِ راهنما — فروغ آریا پارسیان</PageTitle>

<div class="wrap">
    <div class="page-head">
        <div>
            <nav class="breadcrumb" aria-label="مسیر">
                <a href="/">خانه</a><span>/</span><span>وبلاگ</span>
            </nav>
            <h1 class="page-title">وبلاگ و مرکزِ راهنما</h1>
            <p class="page-sub">راهنمای انتخاب، پیاده‌سازی و استفاده از نرم‌افزارِ سازمانی.</p>
        </div>
    </div>

    <div class="row-2" style="margin-bottom:var(--sp-5);gap:var(--sp-4);align-items:center;flex-wrap:wrap">
        <div class="search" style="max-width:420px;flex:1">
            <span class="search__icon"><Icon Name="search" Size="16" /></span>
            <input class="input" @bind="search" @bind:event="oninput" @onkeyup="OnSearch" placeholder="جستجو در مقالات…" aria-label="جستجو در مقالات" />
        </div>
        <div class="seg" role="tablist" aria-label="دسته‌بندی مقالات">
            <button class="seg__btn @(cat is null ? "is-active" : "")" role="tab" aria-selected="@(cat is null)" @onclick="() => Pick(null)">همه</button>
            @foreach (var c in categories)
            {
                <button class="seg__btn @(cat == c ? "is-active" : "")" role="tab" aria-selected="@(cat == c)" @onclick="() => Pick(c)">@c</button>
            }
        </div>
    </div>

    @if (paged is null)
    {
        <div class="grid-3">@for (var i = 0; i < 6; i++) { <Skeleton Kind="card" /> }</div>
    }
    else if (paged.Items.Count == 0)
    {
        <EmptyState Icon="book" Title="مقاله‌ای یافت نشد" Text="عبارت یا دستهٔ دیگری را امتحان کنید." />
    }
    else
    {
        <div class="grid-3">
            @foreach (var a in paged.Items)
            {
                <article class="card card--pad card--hover" style="display:flex;flex-direction:column;gap:var(--sp-3)">
                    @if (a.Category is not null)
                    {
                        <span class="badge badge--brand badge--sm">@a.Category</span>
                    }
                    <h2 style="font-size:1.05rem;line-height:1.6;margin:0">
                        <a href="/blog/@a.Slug" style="color:inherit;text-decoration:none">@a.Title</a>
                    </h2>
                    <p class="small muted" style="margin:0;line-height:1.85">@a.Excerpt</p>
                    <div class="row-2 tiny muted" style="margin-top:auto;gap:var(--sp-3);border-top:1px solid var(--line);padding-top:var(--sp-3)">
                        <span><Icon Name="calendar" Size="13" /> @Helpers.Fa.Date(a.PublishedAt)</span>
                        <span><Icon Name="clock" Size="13" /> @Helpers.Fa.Num(a.ReadMinutes) دقیقه</span>
                    </div>
                </article>
            }
        </div>

        <Pager Meta="paged.Meta" OnPage="Go" />
    }
</div>

@code {
    private Paged<ArticleDto>? paged;
    private IReadOnlyList<string> categories = Array.Empty<string>();
    private string search = "";
    private string? cat;
    private int page = 1;
    private System.Threading.CancellationTokenSource? debounce;

    protected override async Task OnInitializedAsync()
    {
        categories = await FetchCategories();
        await Reload();
    }

    private async Task<IReadOnlyList<string>> FetchCategories()
    {
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            return await http.GetFromJsonAsync<IReadOnlyList<string>>("api/v1/articles/categories") ?? Array.Empty<string>();
        }
        catch { return Array.Empty<string>(); }
    }

    private async Task Reload()
    {
        paged = await Api.GetArticlesAsync(page, 9, publishedOnly: true);

        if (cat is not null)
            paged = new Paged<ArticleDto>(paged.Items.Where(x => x.Category == cat).ToList(), paged.Meta);

        if (!string.IsNullOrWhiteSpace(search))
        {
            var s = search.Trim();
            paged = new Paged<ArticleDto>(
                paged.Items.Where(x =>
                    x.Title.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    x.Excerpt.Contains(s, StringComparison.OrdinalIgnoreCase)).ToList(),
                paged.Meta);
        }
    }

    private async Task OnSearch()
    {
        debounce?.Cancel();
        debounce = new System.Threading.CancellationTokenSource();
        var token = debounce.Token;
        try
        {
            await Task.Delay(320, token);
            page = 1;
            await Reload();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task Pick(string? c) { cat = c; page = 1; await Reload(); }

    private async Task Go(int p) { page = p; await Reload(); }
}
