@page "/checkout"
@inject Services.CartState Cart
@inject Services.IStoreApi Api
@inject Services.AuthState Auth
@inject Services.ToastService Toast
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>تسویه حساب — فروغ آریا پارسیان</PageTitle>

<div class="wrap" style="padding-block:var(--sp-9)">
    @if (placed is not null)
    {
        <!-- ============ Success ============ -->
        <div class="wrap-sm stack-5">
            <div class="card card--pad-lg" style="text-align:center">
                <span class="stat__icon" style="width:56px;height:56px;border-radius:50%;background:var(--ok-50);color:var(--ok-600);margin-inline:auto">
                    <Icon Name="check" Size="28" />
                </span>
                <h1 style="margin-top:var(--sp-4);font-size:var(--fs-2xl)">سفارش شما ثبت شد</h1>
                <p class="muted-2" style="margin-top:8px">
                    شمارهٔ سفارش <b class="num--lat">@placed.OrderNumber</b> — رسید و فاکتور به ایمیل شما ارسال شد.
                </p>

                <div class="kv" style="margin-top:var(--sp-5);text-align:right">
                    <div class="kv__item"><span class="kv__k">مبلغ پرداخت‌شده</span><span class="kv__v num">@Helpers.Fa.Money(placed.TotalToman)</span></div>
                    <div class="kv__item"><span class="kv__k">وضعیت</span><span class="kv__v"><StatusBadge Status="@placed.Status.ToString()" Kind="order" /></span></div>
                    <div class="kv__item"><span class="kv__k">روش پرداخت</span><span class="kv__v">@MethodLabel(placed.Payment?.Method)</span></div>
                </div>

                <div class="row-2" style="justify-content:center;margin-top:var(--sp-6);flex-wrap:wrap">
                    <a class="btn btn--primary" href="/dashboard/licenses"><Icon Name="key" Size="16" /> مشاهدهٔ لایسنس‌ها</a>
                    <a class="btn btn--secondary" href="/dashboard/orders">سفارش‌های من</a>
                </div>
            </div>
        </div>
    }
    else if (Cart.Cart is null)
    {
        <div class="card"><Skeleton Kind="card" /></div>
    }
    else if (Cart.Cart.Items.Count == 0)
    {
        <div class="card">
            <EmptyState Icon="cart" Title="سبد خرید خالی است" Text="برای ادامه، ابتدا یک طرحِ لایسنس انتخاب کنید.">
                <a class="btn btn--primary btn--sm" href="/catalog">مشاهدهٔ محصولات</a>
            </EmptyState>
        </div>
    }
    else
    {
        <!-- ============ Steps ============ -->
        <div class="progress-steps" style="justify-content:center;margin-bottom:var(--sp-7);flex-wrap:wrap">
            @for (var i = 1; i <= 3; i++)
            {
                var step = i;
                <div class="progress-steps__item @(step == current ? "is-active" : step < current ? "is-done" : "")">
                    <span class="progress-steps__dot">
                        @if (step < current) { <Icon Name="check" Size="13" /> } else { @Helpers.Fa.Num(step) }
                    </span>
                    <span class="progress-steps__label">@StepName(step)</span>
                </div>
                @if (i < 3)
                {
                    <span class="progress-steps__sep @(i < current ? "is-done" : "")"></span>
                }
            }
        </div>

        <div class="checkout-grid">
            <div class="stack-4">
                @if (current == 1)
                {
                    <div class="card card--pad animate-in">
                        <h2 style="font-size:var(--fs-md);margin-bottom:var(--sp-4)">اطلاعات صورتحساب</h2>
                        <div class="stack-4">
                            <div class="grid-2" style="gap:var(--sp-4)">
                                <label class="field">
                                    <span class="field__label">نام و نام خانوادگی <span class="field__req">*</span></span>
                                    <input class="input @(Invalid("name") ? "is-invalid" : "")" @bind="name" />
                                </label>
                                <label class="field">
                                    <span class="field__label">ایمیل <span class="field__req">*</span></span>
                                    <input class="input input--ltr @(Invalid("email") ? "is-invalid" : "")" @bind="email" placeholder="name@company.com" />
                                </label>
                                <label class="field">
                                    <span class="field__label">شرکت</span>
                                    <input class="input" @bind="company" />
                                </label>
                                <label class="field">
                                    <span class="field__label">کشور <span class="field__req">*</span></span>
                                    <input class="input @(Invalid("country") ? "is-invalid" : "")" @bind="country" />
                                </label>
                                <label class="field">
                                    <span class="field__label">شناسهٔ مالیاتی (اختیاری)</span>
                                    <input class="input input--ltr" @bind="vatId" />
                                </label>
                            </div>

                            @* فاکتورِ رسمی: خریدارِ حقوقی به کدِ اقتصادی و شناسهٔ ملی نیاز دارد. *@
                            <div class="field">
                                <span class="field__label">نوعِ خریدار</span>
                                <div class="row-2" style="gap:var(--sp-2)">
                                    <button type="button"
                                            class="btn btn--sm @(accountType == AccountType.Individual ? "btn--primary" : "btn--secondary")"
                                            @onclick="() => accountType = AccountType.Individual">
                                        <Icon Name="user" Size="15" /> شخصِ حقیقی
                                    </button>
                                    <button type="button"
                                            class="btn btn--sm @(accountType == AccountType.Organization ? "btn--primary" : "btn--secondary")"
                                            @onclick="() => accountType = AccountType.Organization">
                                        <Icon Name="building" Size="15" /> شخصِ حقوقی
                                    </button>
                                </div>
                            </div>

                            @if (accountType == AccountType.Organization)
                            {
                                <div class="grid-2 animate-in" style="gap:var(--sp-4)">
                                    <label class="field">
                                        <span class="field__label">نامِ حقوقی شرکت <span class="field__req">*</span></span>
                                        <input class="input @(Invalid("companyName") ? "is-invalid" : "")" @bind="companyName" />
                                    </label>
                                    <label class="field">
                                        <span class="field__label">کدِ اقتصادی</span>
                                        <input class="input input--ltr" @bind="economicCode" placeholder="۱۲ رقم" />
                                    </label>
                                    <label class="field">
                                        <span class="field__label">شناسهٔ ملی</span>
                                        <input class="input input--ltr" @bind="nationalId" placeholder="۱۱ رقم" />
                                    </label>
                                </div>
                            }
                            <label class="field">
                                <span class="field__label">یادداشت برای تیم مالی</span>
                                <textarea class="textarea" style="min-height:82px" @bind="notes" placeholder="مثل: شمارهٔ سفارشِ خرید داخلی"></textarea>
                            </label>
                            <div class="row-2">
                                <button class="btn btn--primary" @onclick="Next">
                                    ادامه <Icon Name="arrow-left" Size="15" />
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (current == 2)
                {
                    <div class="card card--pad animate-in">
                        <h2 style="font-size:var(--fs-md);margin-bottom:var(--sp-4)">روش پرداخت</h2>
                        <div class="stack-3">
                            @foreach (var m in methods)
                            {
                                <label class="card card--pad @(method == m.Id ? "card--accent" : "")"
                                       style="cursor:pointer;@(method == m.Id ? "border-color:var(--brand-400);box-shadow:0 0 0 3px var(--brand-50)" : "")">
                                    <div class="row-3">
                                        <input type="radio" name="pm" checked="@(method == m.Id)" @onchange="() => method = m.Id" style="width:18px;height:18px;accent-color:var(--brand-600)" />
                                        <span style="color:var(--brand-600)"><Icon Name="@m.Icon" Size="19" /></span>
                                        <span class="grow">
                                            <span class="heavy">@m.Title</span>
                                            <span class="tiny muted" style="display:block">@m.Desc</span>
                                        </span>
                                    </div>
                                </label>
                            }
                        </div>

                        @if (method == "card")
                        {
                            <div class="grid-2 animate-in" style="gap:var(--sp-4);margin-top:var(--sp-4)">
                                <label class="field">
                                    <span class="field__label">نام روی کارت</span>
                                    <input class="input" @bind="cardName" />
                                </label>
                                <label class="field">
                                    <span class="field__label">شمارهٔ کارت</span>
                                    <input class="input input--ltr" @bind="cardNumber" placeholder="4242 4242 4242 4242" />
                                </label>
                            </div>
                        }

                        <div class="row-2" style="margin-top:var(--sp-5)">
                            <button class="btn btn--secondary" @onclick="() => current = 1">بازگشت</button>
                            <button class="btn btn--primary" @onclick="Next">ادامه <Icon Name="arrow-left" Size="15" /></button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card card--pad animate-in">
                        <h2 style="font-size:var(--fs-md);margin-bottom:var(--sp-4)">بازبینی نهایی</h2>

                        <div class="kv" style="margin-bottom:var(--sp-4)">
                            <div class="kv__item"><span class="kv__k">صورتحساب به نام</span><span class="kv__v">@name</span></div>
                            <div class="kv__item"><span class="kv__k">ایمیل</span><span class="kv__v" style="direction:ltr;text-align:right">@email</span></div>
                            <div class="kv__item"><span class="kv__k">کشور</span><span class="kv__v">@country</span></div>
                            <div class="kv__item"><span class="kv__k">روش پرداخت</span><span class="kv__v">@MethodLabel(method)</span></div>
                            <div class="kv__item">
                                <span class="kv__k">نوعِ خریدار</span>
                                <span class="kv__v">@(accountType == AccountType.Organization ? "شخصِ حقوقی" : "شخصِ حقیقی")</span>
                            </div>
                        </div>

                        <div class="divider" style="margin-block:var(--sp-4)"></div>

                        <div class="stack-3">
                            @foreach (var item in Cart.Cart.Items)
                            {
                                <div class="between">
                                    <div>
                                        <div class="heavy" style="font-size:var(--fs-sm)">@item.ProductName</div>
                                        <div class="tiny muted">@item.PlanName · @Helpers.Fa.Num(item.Quantity) عدد</div>
                                    </div>
                                    <span class="num heavy">@Helpers.Fa.Money(item.LineTotalToman)</span>
                                </div>
                            }
                        </div>

                        @if (payError is not null)
                        {
                            <div class="card card--pad" style="margin-top:var(--sp-4);border-color:var(--danger-200,#fecaca);background:var(--danger-50,#fef2f2)">
                                <div class="row-3" style="align-items:flex-start">
                                    <span style="color:var(--danger-600,#dc2626)"><Icon Name="info" Size="17" /></span>
                                    <div class="grow">
                                        <b class="small">پرداخت انجام نشد</b>
                                        <p class="tiny" style="margin-top:4px;color:var(--ink-600)">@payError</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="row-2" style="margin-top:var(--sp-5);flex-wrap:wrap">
                            <button class="btn btn--secondary" @onclick="() => current = 2" disabled="@busy">بازگشت</button>
                            <button class="btn btn--primary btn--lg grow" @onclick="Place" disabled="@busy" aria-busy="@busy">
                                @if (busy) { <span class="btn__spinner"></span> <span>در حال پردازش…</span> }
                                else { <Icon Name="lock" Size="16" /> <span>پرداختِ @Helpers.Fa.Money(Cart.Cart.TotalToman)</span> }
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- ===== Summary ===== -->
            <aside class="summary">
                <div class="card card--pad">
                    <h2 style="font-size:var(--fs-md);margin-bottom:var(--sp-3)">خلاصه</h2>
                    <div class="stack-3" style="margin-bottom:var(--sp-3)">
                        @foreach (var item in Cart.Cart.Items)
                        {
                            <div class="row-3">
                                <span class="prod-card__icon" style="width:32px;height:32px;border-radius:var(--r-sm);background:@(item.AccentColor)1a;color:@item.AccentColor">
                                    <Icon Name="package" Size="15" />
                                </span>
                                <span class="grow" style="min-width:0">
                                    <span class="small heavy truncate" style="display:block">@item.ProductName</span>
                                    <span class="tiny muted">@item.PlanName</span>
                                </span>
                                <span class="small num">@Helpers.Fa.Money(item.LineTotalToman)</span>
                            </div>
                        }
                    </div>

                    <div class="divider"></div>

                    <div class="summary__row"><span>جمع کل</span><span class="num">@Helpers.Fa.Money(Cart.Cart.SubtotalToman)</span></div>
                    @if (Cart.Cart.DiscountToman > 0)
                    {
                        <div class="summary__row" style="color:var(--ok-600)">
                            <span>تخفیف</span><span class="num">−@Helpers.Fa.Money(Cart.Cart.DiscountToman)</span>
                        </div>
                    }
                    <div class="summary__row"><span>مالیات</span><span class="num">@Helpers.Fa.Money(Cart.Cart.TaxToman)</span></div>
                    <div class="summary__row summary__row--total"><span>قابل پرداخت</span><span class="num">@Helpers.Fa.Money(Cart.Cart.TotalToman)</span></div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private int current = 1;
    private bool busy;
    private OrderDto? placed;

    private string name = "";
    private string email = "";
    private string company = "";
    private string country = "";
    private string vatId = "";
    private string notes = "";
    private AccountType accountType = AccountType.Individual;
    private string companyName = "";
    private string economicCode = "";
    private string nationalId = "";
    private string? payError;
    private string method = "card";
    private string cardName = "";
    private string cardNumber = "";
    private bool touched;

    private static readonly IReadOnlyList<(string Id, string Title, string Desc, string Icon)> methods = new[]
    {
        ("card", "کارت اعتباری", "پرداخت آنی و صدور فوریِ لایسنس", "credit-card"),
        ("invoice", "فاکتورِ مدت‌دار", "پرداخت تا ۱۴ روز پس از صدور فاکتور", "file"),
        ("bank-transfer", "انتقال بانکی", "برای سازمان‌ها و مبالغِ بالا", "building"),
    };

    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
        if (Auth.User is { } u)
        {
            name = u.FullName;
            email = u.Email;
            company = u.Company ?? "";
            country = u.Country ?? "";
        }
    }

    private static string StepName(int s) => s switch { 1 => "صورتحساب", 2 => "پرداخت", _ => "تأیید" };

    private static string MethodLabel(string? m) => m switch
    {
        "card" => "کارت اعتباری",
        "invoice" => "فاکتورِ مدت‌دار",
        "bank-transfer" => "انتقال بانکی",
        _ => "—",
    };

    private bool Invalid(string field) => touched && string.IsNullOrWhiteSpace(field switch
    {
        "name" => name,
        "email" => email,
        "country" => country,
        "companyName" => accountType == AccountType.Organization ? companyName : "—",
        _ => ""
    }) || (touched && field == "email" && !email.Contains('@'));

    private void Next()
    {
        touched = true;
        if (current == 1)
        {
            if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(country) || !email.Contains('@'))
            {
                Toast.Push("اطلاعات ناقص است", "نام، ایمیل معتبر و کشور را وارد کنید.", ToastTone.Warn);
                return;
            }
            if (accountType == AccountType.Organization && string.IsNullOrWhiteSpace(companyName))
            {
                Toast.Push("نامِ حقوقی لازم است", "برایِ فاکتورِ رسمی، نامِ شرکت را وارد کنید.", ToastTone.Warn);
                return;
            }
        }
        current = Math.Min(3, current + 1);
    }

    /// <summary>
    /// ثبتِ سفارش رویِ <c>POST /api/v1/checkout</c>.
    ///
    /// اگر سرور رد کند (موجودی، کدِ تخفیفِ منقضی، سبدِ خالی)، پیامِ فارسیِ خودِ
    /// سرور در همان گامِ تأیید نشان داده می‌شود و کاربر داده‌هایش را از دست
    /// نمی‌دهد. دکمه هم در حینِ درخواست قفل می‌شود تا سفارشِ تکراری ثبت نشود.
    /// </summary>
    private async Task Place()
    {
        if (Cart.Cart is null || busy) return;

        busy = true;
        payError = null;
        StateHasChanged();

        try
        {
            placed = await Api.CheckoutAsync(new CheckoutInput(
                Cart.SessionKey, Cart.Cart.DiscountCode, method, cardName, cardNumber,
                name, company, email, country, vatId, notes,
                accountType,
                string.IsNullOrWhiteSpace(economicCode) ? null : economicCode,
                string.IsNullOrWhiteSpace(nationalId) ? null : nationalId,
                string.IsNullOrWhiteSpace(companyName) ? null : companyName));

            await Cart.RefreshAsync();
            Toast.Push("پرداخت موفق بود", $"سفارش {placed.OrderNumber} ثبت شد.", ToastTone.Ok);
        }
        catch (Services.V1.V1ApiException ex)
        {
            payError = ex.Message;
            Toast.Push("سفارش ثبت نشد", ex.Message, ToastTone.Bad);
        }
        catch (Exception ex)
        {
            payError = "ارتباط با سرور برقرار نشد؛ چند لحظه بعد دوباره تلاش کنید.";
            Console.WriteLine("[checkout] " + ex.Message);
            Toast.Push("ارتباط برقرار نشد", payError, ToastTone.Bad);
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Cart.OnChange -= StateHasChanged;
}
