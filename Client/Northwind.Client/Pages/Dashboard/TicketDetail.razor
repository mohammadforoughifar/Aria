@page "/dashboard/tickets/{id}"
@layout Shared.Layout.DashboardLayout
@inject Services.IStoreApi Api
@inject Services.AuthState Auth
@inject Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>@(ticket?.Subject ?? "تیکت") — فروغ آریا پارسیان</PageTitle>

@if (loading)
{
    <div class="stack-4">
        <Skeleton Kind="card" />
        <Skeleton Kind="card" />
    </div>
}
else if (ticket is null)
{
    <div class="card">
        <EmptyState Icon="ticket" Title="تیکت پیدا نشد" Text="این تیکت حذف شده یا به حسابِ شما تعلق ندارد.">
            <a class="btn btn--primary btn--sm" href="/dashboard/tickets">بازگشت به تیکت‌ها</a>
        </EmptyState>
    </div>
}
else
{
    <div class="breadcrumb" style="margin-bottom:var(--sp-4)">
        <a href="/dashboard">پیشخوان</a> <Icon Name="chevron-left" Size="13" />
        <a href="/dashboard/tickets">تیکت‌ها</a> <Icon Name="chevron-left" Size="13" />
        <span class="num--lat">@ticket.Reference</span>
    </div>

    <div class="grid-2-1">
        <div class="stack-4">
            <!-- ===== Header ===== -->
            <div class="card card--pad">
                <div class="between" style="flex-wrap:wrap;gap:var(--sp-3)">
                    <h1 style="font-size:var(--fs-xl)">@ticket.Subject</h1>
                    <div class="row-2">
                        <StatusBadge Status="@ticket.Status.ToString()" Kind="ticket" />
                        <StatusBadge Status="@ticket.Priority.ToString()" Kind="priority" />
                    </div>
                </div>
                <div class="divider" style="margin-block:var(--sp-4)"></div>
                <div class="kv">
                    <div class="kv__item"><span class="kv__k">محصول</span><span class="kv__v">@(ticket.ProductName ?? "—")</span></div>
                    <div class="kv__item"><span class="kv__k">دسته‌بندی</span><span class="kv__v">@ticket.Category</span></div>
                    <div class="kv__item"><span class="kv__k">ایجاد</span><span class="kv__v">@Helpers.Fa.DateTime(ticket.CreatedAt)</span></div>
                    <div class="kv__item"><span class="kv__k">آخرین به‌روزرسانی</span><span class="kv__v">@Helpers.Fa.TimeAgo(ticket.UpdatedAt)</span></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(ticket.Environment))
                {
                    <div class="badge badge--neutral" style="margin-top:var(--sp-3);height:auto;padding:6px 10px">
                        <Icon Name="monitor" Size="12" /> @ticket.Environment
                    </div>
                }
            </div>

            <!-- ===== Thread ===== -->
            <div class="card card--pad">
                <div class="thread">
                    @foreach (var m in ticket.Messages)
                    {
                        var mine = m.AuthorName == Auth.User?.FullName && !m.IsStaff;
                        <div class="thread__msg thread__msg--@(m.IsStaff ? "staff" : (mine ? "me" : "other"))">
                            <span class="avatar">@Helpers.Fa.Initials(m.AuthorName)</span>
                            <div>
                                <div class="thread__bubble">
                                    <div class="thread__who">
                                        <b>@m.AuthorName</b>
                                        @if (m.IsStaff) { <span class="badge badge--brand badge--sm">پشتیبانی</span> }
                                        <time>@Helpers.Fa.DateTime(m.CreatedAt)</time>
                                    </div>
                                    <div class="thread__text">@m.Body</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ===== Reply ===== -->
            @if (ticket.Status != TicketStatus.Closed)
            {
                <div class="card card--pad">
                    <label class="field">
                        <span class="field__label">پاسخ شما</span>
                        <textarea class="textarea" style="min-height:110px" @bind="reply"
                                  placeholder="پاسخ یا توضیحِ تکمیلی خود را بنویسید…"></textarea>
                    </label>

                    <div class="between" style="margin-top:var(--sp-3);flex-wrap:wrap;gap:var(--sp-3)">
                        <label class="check">
                            <input type="checkbox" @bind="closeAfter" />
                            <span class="small">اگر مشکل حل شده، تیکت را ببند</span>
                        </label>

                        <button class="btn btn--primary" @onclick="Send" disabled="@busy">
                            @if (busy) { <span class="btn__spinner"></span> <span>در حال ارسال…</span> }
                            else { <span>ارسال پاسخ</span> <Icon Name="arrow-left" Size="15" /> }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card card--pad" style="text-align:center">
                    <p class="small muted">این تیکت بسته شده است. برای ادامه، تیکتِ جدیدی باز کنید.</p>
                    <a class="btn btn--secondary btn--sm" style="margin-top:var(--sp-3)" href="/dashboard/tickets">تیکت جدید</a>
                </div>
            }
        </div>

        <!-- ===== Sidebar ===== -->
        <aside class="stack-4">
            <div class="card card--pad">
                <span class="card__title" style="display:block;margin-bottom:var(--sp-3)">روندِ تیکت</span>
                <div class="timeline">
                    <div class="timeline__item">
                        <span class="timeline__dot timeline__dot--ok"><Icon Name="plus" Size="11" /></span>
                        <div class="timeline__body">
                            <div class="timeline__title">تیکت ایجاد شد</div>
                            <div class="timeline__meta">@Helpers.Fa.DateTime(ticket.CreatedAt)</div>
                        </div>
                    </div>
                    <div class="timeline__item">
                        <span class="timeline__dot @(ticket.Status == TicketStatus.Open ? "timeline__dot--brand" : "timeline__dot--ok")">
                            <Icon Name="clock" Size="11" />
                        </span>
                        <div class="timeline__body">
                            <div class="timeline__title">در صفِ بررسی</div>
                            <div class="timeline__meta">پاسخِ اولیه زیر ۴ ساعتِ کاری</div>
                        </div>
                    </div>
                    <div class="timeline__item">
                        <span class="timeline__dot @(ticket.Status is TicketStatus.Resolved or TicketStatus.Closed ? "timeline__dot--ok" : "")">
                            <Icon Name="check" Size="11" />
                        </span>
                        <div class="timeline__body">
                            <div class="timeline__title">حل‌شده</div>
                            <div class="timeline__meta">@(ticket.Status is TicketStatus.Resolved or TicketStatus.Closed ? "تکمیل شد" : "در انتظار")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card--pad" style="background:var(--surface-sunk)">
                <div class="row-2" style="margin-bottom:var(--sp-2)">
                    <span style="color:var(--brand-600)"><Icon Name="headphones" Size="16" /></span>
                    <span class="heavy">تماسِ مستقیم</span>
                </div>
                <p class="small muted" style="line-height:var(--lh-relax)">
                    برای مواردِ بحرانی، علاوه بر تیکت می‌توانید مستقیماً با پشتیبانی تماس بگیرید و شمارهٔ
                    <span class="num--lat">@ticket.Reference</span> را اعلام کنید.
                </p>
                <a class="btn btn--secondary btn--sm btn--block" style="margin-top:var(--sp-3)" href="/support">مرکز پشتیبانی</a>
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private TicketDetailDto? ticket;
    private bool loading = true;
    private bool busy;
    private string reply = "";
    private bool closeAfter;

    protected override async Task OnInitializedAsync()
    {
        ticket = await Api.GetTicketAsync(Id);
        loading = false;
    }

    private async Task Send()
    {
        if (ticket is null || reply.Trim().Length < 2) return;

        busy = true;
        ticket = await Api.AddTicketMessageAsync(ticket.Id, reply.Trim(),
            closeAfter ? TicketStatus.Closed : null);
        reply = ""; closeAfter = false; busy = false;

        Toast.Push("پاسخ ارسال شد", null, ToastTone.Ok);
        StateHasChanged();
    }
}
