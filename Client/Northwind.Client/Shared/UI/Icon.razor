</svg>

@code {
    [Parameter] public string Name { get; set; } = "package";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public double StrokeWidth { get; set; } = 1.8;
}
