@* امتیازِ ستاره‌ای *@
<span class="rating" title="@Value.ToString("0.0") از ۵">
    @for (var i = 1; i <= 5; i++)
    {
        var filled = i <= Math.Round(Value, MidpointRounding.AwayFromZero);
        <span class="rating__star @(filled ? "" : "rating__star--off")">
            <Icon Name="star" Size="@Size" />
        </span>
    }
    @if (ShowValue)
    {
        <span class="rating__value">@Helpers.Fa.DigitsOf(Value.ToString("0.0"))</span>
    }
    @if (Count is > 0)
    {
        <span class="rating__value">(@Helpers.Fa.Num(Count.Value))</span>
    }
</span>

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public int Size { get; set; } = 14;
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public int? Count { get; set; }
}
