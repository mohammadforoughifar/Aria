@* کارتِ محصول *@
@inject Services.CartState Cart
@inject Services.CompareState Compare
@inject Services.ToastService Toast
@inject NavigationManager Nav
@implements IDisposable

<article class="prod-card">
    <div class="prod-card__stripe" style="background:linear-gradient(90deg,@Product.AccentColor,@(Product.AccentColor)99)"></div>

    @if (Product.IsFeatured)
    {
        <span class="prod-card__flag badge badge--brand badge--plain">
            <Icon Name="sparkles" Size="11" /> ویژه
        </span>
    }

    <div class="prod-card__body">
        <div class="prod-card__top">
            <span class="prod-card__icon" style="background:@(Product.AccentColor)1a;color:@Product.AccentColor">
                <Icon Name="@Icon" Size="19" />
            </span>
            <div class="grow">
                <h3 class="prod-card__name">
                    <a href="/products/@Product.Slug" style="color:inherit">@Product.Name</a>
                </h3>
                <div class="prod-card__cat">@Product.CategoryName</div>
            </div>
            <button class="icon-btn" style="width:32px;height:32px"
                    title="@(Compare.Contains(Product.Id) ? "حذف از مقایسه" : "افزودن به مقایسه")"
                    @onclick="ToggleCompare"
                    disabled="@(!Compare.Contains(Product.Id) && Compare.IsFull)">
                <span style="color:@(Compare.Contains(Product.Id) ? "var(--brand-600)" : "var(--ink-400)")">
                    <Icon Name="@(Compare.Contains(Product.Id) ? "check" : "plus")" Size="16" />
                </span>
            </button>
        </div>

        <p class="prod-card__tagline clamp-2">@Product.Tagline</p>

        <div class="row-3" style="flex-wrap:wrap">
            <span class="badge badge--plain badge--neutral">@TypeLabel</span>
            <span class="tiny muted">نسخهٔ <span class="num--lat">@Product.Version</span></span>
        </div>

        <div class="row" style="justify-content:space-between;margin-top:auto">
            <Stars Value="Product.RatingAvg" Count="Product.RatingCount" Size="13" />
            <span class="tiny muted row-2"><Icon Name="download" Size="12" /> @Helpers.Fa.Num(Product.Popularity)</span>
        </div>
    </div>

    <div class="prod-card__foot">
        <div>
            <div class="prod-card__price">@Helpers.Fa.Money(Product.BasePriceToman)</div>
            <div class="tiny muted">@Helpers.Fa.Num(Product.PlanCount) طرحِ لایسنس</div>
        </div>
        <div class="row-2">
            <a class="btn btn--secondary btn--sm" href="/products/@Product.Slug">جزئیات</a>
            <button class="btn btn--soft btn--sm" @onclick="Add">
                <Icon Name="cart" Size="14" /> انتخاب طرح
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter] public ProductListItemDto Product { get; set; } = default!;

    private string Icon => Product.CategorySlug switch
    {
        "erp-suite" => "layers",
        "finance-accounting" => "calculator",
        "operations-inventory" => "boxes",
        "desktop-productivity" => "monitor",
        "addons-integrations" => "puzzle",
        _ => "package",
    };

    private string TypeLabel => Product.Type switch
    {
        ProductType.Module => "ماژول",
        ProductType.DesktopApp => "دسکتاپ",
        _ => "افزونه",
    };

    protected override void OnInitialized() => Compare.OnChange += StateHasChanged;
    public void Dispose() => Compare.OnChange -= StateHasChanged;

    private void ToggleCompare()
    {
        var removed = Compare.Toggle(Product.Id);
        Toast.Push(removed ? "از مقایسه حذف شد" : "به مقایسه اضافه شد",
            Product.Name, removed ? ToastTone.Info : ToastTone.Ok);
    }

    private void Add() => Nav.NavigateTo($"/products/{Product.Slug}#plans");
}
