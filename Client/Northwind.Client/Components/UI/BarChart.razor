@* نمودار ستونی — SVGِ خالص با تولتیپ *@
<div class="chart" style="position:relative">
    <svg viewBox="0 0 @Width @(Height + 26)" preserveAspectRatio="none" style="width:100%;height:@(Height + 26)px;overflow:visible">
        @for (var g = 0; g <= 3; g++)
        {
            var gy = Height - (Height * g / 3.0);
            <line class="chart__grid" x1="0" y1="@gy" x2="@Width" y2="@gy" />
        }

        @for (var i = 0; i < Data.Count; i++)
        {
            var point = Data[i];
            var ratio = Max == 0 ? 0 : (double)point.Value / Max;
            var h = Math.Max(3, ratio * Height);
            var x = i * Slot + Slot * 0.22;
            var w = Slot * 0.56;
            var index = i;
            <rect class="chart__bar @(hover == index ? "" : (hover is null ? "" : "chart__bar--dim"))"
                  x="@x" y="@(Height - h)" width="@w" height="@h" rx="4"
                  fill="url(#barGrad)" @onmouseenter="() => hover = index" @onmouseleave="() => hover = null" />
        }

        <defs>
            <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="@ColorTop" />
                <stop offset="100%" stop-color="@ColorBottom" />
            </linearGradient>
        </defs>

        @foreach (var label in Labels())
        {
            @((MarkupString)label)
        }
    </svg>

    @if (hover is { } idx && idx < Data.Count)
    {
        var leftPct = (idx * Slot + Slot * 0.5) / Width * 100.0;
        var topPx = Height - (Max == 0 ? 0 : (double)Data[idx].Value / Max) * Height;
        <div class="chart__tip" style="left:@(leftPct.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))%;top:@(topPx.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))px">
            @Data[idx].Label — @Format(Data[idx].Value)
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChartPoint> Data { get; set; } = Array.Empty<ChartPoint>();
    [Parameter] public int Height { get; set; } = 180;
    [Parameter] public Func<long, string>? Formatter { get; set; }
    [Parameter] public string ColorTop { get; set; } = "#818cf8";
    [Parameter] public string ColorBottom { get; set; } = "#6366f1";

    private const int Width = 600;
    private int? hover;

    private long Max => Data.Count == 0 ? 0 : Math.Max(1, Data.Max(d => d.Value));
    private double Slot => Width / (double)Math.Max(1, Data.Count);

    private string Format(long value) => Formatter is null ? Helpers.Fa.Num(value) : Formatter(value);

    // تگ <text> در SVG با تگِ ویژهٔ Razor تداخل دارد؛ برچسب‌ها را به‌شکل MarkupString می‌سازیم.
    private IReadOnlyList<string> Labels()
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        const string open = "<text class='chart__label'";
        return Data.Select((point, i) =>
            $"{open} x='{(i * Slot + Slot * 0.5).ToString("0.0", inv)}' y='{Height + 18}' text-anchor='middle'>{point.Label}</text>")
            .ToList();
    }
}
