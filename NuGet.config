<?xml version="1.0" encoding="utf-8"?>
<!--
  چرا این فایل هست؟
  ─────────────────
  پروژه فقط از بسته‌هایِ عمومیِ nuget.org استفاده می‌کند. اگر رویِ سیستمِ شما
  «Package Source Mapping» روشن باشد و الگویی برایِ nuget.org نداشته باشد،
  بستهٔ زمان‌اجرایِ Blazor WebAssembly
  (Microsoft.NETCore.App.Runtime.Mono.browser-wasm) پیدا نمی‌شود و خطایِ
  NU1100 می‌دهد:
      «Unable to resolve … PackageSourceMapping is enabled, the following
       source(s) were not considered: nuget.org»

  این فایل، تنظیماتِ ماشین را برایِ همین Solution بازنویسی می‌کند:
  منابع پاک می‌شوند، nuget.org تنها منبع می‌شود، و الگویِ «*» همهٔ بسته‌ها
  را به همان منبع نگاشت می‌کند.

  اگر روزی فیدِ خصوصیِ سازمانی لازم شد، آن را در <packageSources> اضافه کنید
  و در <packageSourceMapping> الگویِ مربوطه (مثلاً MyCompany.*) را به آن بدهید.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
