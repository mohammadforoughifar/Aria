<Project Sdk="Microsoft.NET.Sdk">

  <!-- لایهٔ ۳: API
       فقط کنترلرها، میان‌افزارِ خطا و سیم‌کشیِ HTTP. منطقِ کاری اینجا نیست؛
       کنترلر حداکثر یک خط است که سرویسِ هسته را صدا می‌زند. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Northwind.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Northwind.Core\Northwind.Core.csproj" />
  </ItemGroup>

</Project>
