{
  "//": "این فایل را به appsettings.Development.json تغییرِ نام دهید یا بخشِ Database را به appsettings.json اضافه کنید.",

  "Database": {
    "ConnectionString": "Server=localhost,1433;Database=NorthwindStorefront;User Id=sa;Password=Your_password123;TrustServerCertificate=True;",
    "UseSqliteFallback": true,
    "SqlitePath": "App_Data/northwind-preview.db",
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true,
    "ConnectRetrySeconds": 3
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
